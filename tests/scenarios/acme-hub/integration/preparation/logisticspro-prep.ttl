@prefix prep: <https://acme.example/preparation/logisticspro#> .
@prefix bronze: <https://acme.example/bronze/logisticspro#> .
@prefix kairos-prep: <https://kairos.cnext.eu/preparation#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://acme.example/preparation/logisticspro> a owl:Ontology ;
    rdfs:label "LogisticsPro preparation policy"@en ;
    rdfs:comment "Pass-through preparation contracts for logistics source records."@en ;
    owl:imports <https://kairos.cnext.eu/preparation>,
                <https://acme.example/bronze/logisticspro> ;
    owl:versionInfo "1.0.0" .

prep:shipmentPartyPolicy a kairos-prep:PreparationPolicy ;
    kairos-prep:sourceTable bronze:tblShipmentParty ;
    kairos-prep:prepMode "normalize" ;
    kairos-prep:schemaChangePolicy "fail" ;
    kairos-prep:recordKeyPolicy prep:shipmentPartyKey ;
    kairos-prep:cdcMapping prep:shipmentPartyCdc .

prep:carrierPolicy a kairos-prep:PreparationPolicy ;
    kairos-prep:sourceTable bronze:tblCarrier ;
    kairos-prep:prepMode "normalize" ;
    kairos-prep:schemaChangePolicy "fail" ;
    kairos-prep:recordKeyPolicy prep:carrierKey ;
    kairos-prep:cdcMapping prep:carrierCdc .

prep:shipmentPartyCdc a kairos-prep:CdcMapping ;
    kairos-prep:rawOperationColumn bronze:tblShipmentParty_PartyCode ;
    kairos-prep:rawUpdateTimestampColumn bronze:tblShipmentParty_PartyCode ;
    kairos-prep:rawEffectiveTimestampColumn bronze:tblShipmentParty_PartyCode ;
    kairos-prep:rawIngestionTimestampColumn bronze:tblShipmentParty_PartyCode ;
    kairos-prep:rawSequenceColumn bronze:tblShipmentParty_PartyCode ;
    kairos-prep:operationCodeMap "*=snapshot" ;
    kairos-prep:normalizedOperationField prep:cdcOperation ;
    kairos-prep:normalizedUpdateTimestampField prep:sourceUpdatedAt ;
    kairos-prep:normalizedEffectiveTimestampField prep:sourceEffectiveAt ;
    kairos-prep:normalizedIngestionTimestampField prep:ingestedAt ;
    kairos-prep:normalizedSequenceField prep:cdcSequence .

prep:carrierCdc a kairos-prep:CdcMapping ;
    kairos-prep:rawOperationColumn bronze:tblCarrier_CarrierCode ;
    kairos-prep:rawUpdateTimestampColumn bronze:tblCarrier_CarrierCode ;
    kairos-prep:rawEffectiveTimestampColumn bronze:tblCarrier_CarrierCode ;
    kairos-prep:rawIngestionTimestampColumn bronze:tblCarrier_CarrierCode ;
    kairos-prep:rawSequenceColumn bronze:tblCarrier_CarrierCode ;
    kairos-prep:operationCodeMap "*=snapshot" ;
    kairos-prep:normalizedOperationField prep:cdcOperation ;
    kairos-prep:normalizedUpdateTimestampField prep:sourceUpdatedAt ;
    kairos-prep:normalizedEffectiveTimestampField prep:sourceEffectiveAt ;
    kairos-prep:normalizedIngestionTimestampField prep:ingestedAt ;
    kairos-prep:normalizedSequenceField prep:cdcSequence .

prep:shipmentPartyKey a kairos-prep:RecordKeyPolicy ;
    kairos-prep:sourceScope "logisticspro" ;
    kairos-prep:tableScope "tblShipmentParty" ;
    kairos-prep:recordKeyComponent bronze:tblShipmentParty_PartyCode ;
    kairos-prep:recordKeyOutput prep:sourceRecordKey .

prep:carrierKey a kairos-prep:RecordKeyPolicy ;
    kairos-prep:sourceScope "logisticspro" ;
    kairos-prep:tableScope "tblCarrier" ;
    kairos-prep:recordKeyComponent bronze:tblCarrier_CarrierCode ;
    kairos-prep:recordKeyOutput prep:sourceRecordKey .

prep:sourceRecordKey a kairos-prep:PreparedColumn ;
    kairos-prep:targetColumnName "_source_record_key" ;
    kairos-prep:targetType "string" .

prep:cdcOperation a kairos-prep:PreparedColumn ;
    kairos-prep:targetColumnName "_cdc_operation" ;
    kairos-prep:targetType "string" .
prep:sourceUpdatedAt a kairos-prep:PreparedColumn ;
    kairos-prep:targetColumnName "_source_updated_at" ;
    kairos-prep:targetType "timestamp" .
prep:sourceEffectiveAt a kairos-prep:PreparedColumn ;
    kairos-prep:targetColumnName "_source_effective_at" ;
    kairos-prep:targetType "timestamp" .
prep:ingestedAt a kairos-prep:PreparedColumn ;
    kairos-prep:targetColumnName "_ingested_at" ;
    kairos-prep:targetType "timestamp" .
prep:cdcSequence a kairos-prep:PreparedColumn ;
    kairos-prep:targetColumnName "_cdc_sequence" ;
    kairos-prep:targetType "string" .
