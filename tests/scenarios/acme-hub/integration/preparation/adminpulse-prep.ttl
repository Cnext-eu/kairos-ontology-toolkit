@prefix prep: <https://acme.example/preparation/adminpulse#> .
@prefix bronze: <https://acme.example/bronze/adminpulse#> .
@prefix kairos-prep: <https://kairos.cnext.eu/preparation#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<https://acme.example/preparation/adminpulse> a owl:Ontology ;
    rdfs:label "AdminPulse preparation policy"@en ;
    rdfs:comment "Source-owned preparation contracts for AdminPulse tables."@en ;
    owl:imports <https://kairos.cnext.eu/preparation>,
                <https://acme.example/bronze/adminpulse> ;
    owl:versionInfo "1.0.0" .

prep:tblClientPolicy a kairos-prep:PreparationPolicy ;
    kairos-prep:sourceTable bronze:tblClient ;
    kairos-prep:prepMode "normalize" ;
    kairos-prep:schemaChangePolicy "fail" ;
    kairos-prep:recordKeyPolicy prep:tblClientKey ;
    kairos-prep:cdcMapping prep:tblClientCdc ;
    kairos-prep:physicalRename prep:tblClientTypeRename ;
    kairos-prep:typeConversion prep:tblClientIdCast .

prep:tblClientTypeRename a kairos-prep:PhysicalRename ;
    kairos-prep:sourceColumn bronze:tblClient_Type ;
    kairos-prep:targetColumnName "client_type_code" .

prep:tblClientIdCast a kairos-prep:TypeConversion ;
    kairos-prep:sourceColumn bronze:tblClient_ClientID ;
    kairos-prep:targetType "string" ;
    kairos-prep:parsePolicy "integer-lexical" ;
    kairos-prep:errorPolicy "fail" .

prep:tblClientCdc a kairos-prep:CdcMapping ;
    kairos-prep:rawOperationColumn bronze:tblClient_ClientID ;
    kairos-prep:rawUpdateTimestampColumn bronze:tblClient_ModifiedDate ;
    kairos-prep:rawEffectiveTimestampColumn bronze:tblClient_ModifiedDate ;
    kairos-prep:rawIngestionTimestampColumn bronze:tblClient_ModifiedDate ;
    kairos-prep:rawSequenceColumn bronze:tblClient_ClientID ;
    kairos-prep:operationCodeMap "*=snapshot" ;
    kairos-prep:normalizedOperationField prep:cdcOperation ;
    kairos-prep:normalizedUpdateTimestampField prep:sourceUpdatedAt ;
    kairos-prep:normalizedEffectiveTimestampField prep:sourceEffectiveAt ;
    kairos-prep:normalizedIngestionTimestampField prep:ingestedAt ;
    kairos-prep:normalizedSequenceField prep:cdcSequence .

prep:sourceUpdatedAt a kairos-prep:PreparedColumn ;
    kairos-prep:targetColumnName "_source_updated_at" ;
    kairos-prep:targetType "timestamp" .

prep:tblClientPIIPolicy a kairos-prep:PreparationPolicy ;
    kairos-prep:sourceTable bronze:tblClientPII ;
    kairos-prep:prepMode "normalize" ;
    kairos-prep:schemaChangePolicy "fail" ;
    kairos-prep:recordKeyPolicy prep:tblClientPIIKey ;
    kairos-prep:cdcMapping prep:tblClientPIICdc ;
    kairos-prep:cleanupRule prep:tblClientPIINationalIdTrim ;
    kairos-prep:typeConversion prep:tblClientPIIClientIdCast .

prep:tblClientPIINationalIdTrim a kairos-prep:CleanupRule ;
    kairos-prep:sourceColumn bronze:tblClientPII_NationalID ;
    kairos-prep:cleanupOperation "trim" ;
    kairos-prep:lossless true .

prep:tblClientPIIClientIdCast a kairos-prep:TypeConversion ;
    kairos-prep:sourceColumn bronze:tblClientPII_ClientID ;
    kairos-prep:targetType "string" ;
    kairos-prep:parsePolicy "integer-lexical" ;
    kairos-prep:errorPolicy "fail" .

prep:tblClientPIICdc a kairos-prep:CdcMapping ;
    kairos-prep:rawOperationColumn bronze:tblClientPII_ClientID ;
    kairos-prep:rawUpdateTimestampColumn bronze:tblClientPII_DateOfBirth ;
    kairos-prep:rawEffectiveTimestampColumn bronze:tblClientPII_DateOfBirth ;
    kairos-prep:rawIngestionTimestampColumn bronze:tblClientPII_DateOfBirth ;
    kairos-prep:rawSequenceColumn bronze:tblClientPII_ClientID ;
    kairos-prep:operationCodeMap "*=snapshot" ;
    kairos-prep:normalizedOperationField prep:cdcOperation ;
    kairos-prep:normalizedUpdateTimestampField prep:sourceUpdatedAt ;
    kairos-prep:normalizedEffectiveTimestampField prep:sourceEffectiveAt ;
    kairos-prep:normalizedIngestionTimestampField prep:ingestedAt ;
    kairos-prep:normalizedSequenceField prep:cdcSequence .

prep:tblClientTypePolicy a kairos-prep:PreparationPolicy ;
    kairos-prep:sourceTable bronze:tblClientType ;
    kairos-prep:prepMode "normalize" ;
    kairos-prep:schemaChangePolicy "fail" ;
    kairos-prep:recordKeyPolicy prep:tblClientTypeKey ;
    kairos-prep:cdcMapping prep:tblClientTypeCdc .

prep:tblClientTypeCdc a kairos-prep:CdcMapping ;
    kairos-prep:rawOperationColumn bronze:tblClientType_TypeCode ;
    kairos-prep:rawUpdateTimestampColumn bronze:tblClientType_TypeCode ;
    kairos-prep:rawEffectiveTimestampColumn bronze:tblClientType_TypeCode ;
    kairos-prep:rawIngestionTimestampColumn bronze:tblClientType_TypeCode ;
    kairos-prep:rawSequenceColumn bronze:tblClientType_TypeCode ;
    kairos-prep:operationCodeMap "*=snapshot" ;
    kairos-prep:normalizedOperationField prep:cdcOperation ;
    kairos-prep:normalizedUpdateTimestampField prep:sourceUpdatedAt ;
    kairos-prep:normalizedEffectiveTimestampField prep:sourceEffectiveAt ;
    kairos-prep:normalizedIngestionTimestampField prep:ingestedAt ;
    kairos-prep:normalizedSequenceField prep:cdcSequence .

prep:tblRelationPolicy a kairos-prep:PreparationPolicy ;
    kairos-prep:sourceTable bronze:tblRelation ;
    kairos-prep:prepMode "normalize" ;
    kairos-prep:schemaChangePolicy "fail" ;
    kairos-prep:recordKeyPolicy prep:tblRelationKey ;
    kairos-prep:cdcMapping prep:tblRelationCdc ;
    kairos-prep:physicalRename prep:tblRelationTypeRename ;
    kairos-prep:typeConversion prep:tblRelationClientIdCast ;
    kairos-prep:technicalDedupe prep:tblRelationDedupe .

prep:tblRelationDedupe a kairos-prep:TechnicalDedupe ;
    kairos-prep:dedupeKeyColumn bronze:tblRelation_ClientID ;
    kairos-prep:dedupeOrderTerm prep:tblRelationOrderModified,
                                prep:tblRelationOrderId .

prep:tblRelationOrderModified a kairos-prep:DedupeOrderTerm ;
    kairos-prep:sourceColumn bronze:tblRelation_ModifiedDate ;
    kairos-prep:orderPosition "1"^^xsd:positiveInteger ;
    kairos-prep:sortDirection "DESC" .

prep:tblRelationOrderId a kairos-prep:DedupeOrderTerm ;
    kairos-prep:sourceColumn bronze:tblRelation_RelationID ;
    kairos-prep:orderPosition "2"^^xsd:positiveInteger ;
    kairos-prep:sortDirection "DESC" .

prep:tblRelationTypeRename a kairos-prep:PhysicalRename ;
    kairos-prep:sourceColumn bronze:tblRelation_Type ;
    kairos-prep:targetColumnName "relation_type" .

prep:tblRelationClientIdCast a kairos-prep:TypeConversion ;
    kairos-prep:sourceColumn bronze:tblRelation_ClientID ;
    kairos-prep:targetType "string" ;
    kairos-prep:parsePolicy "integer-lexical" ;
    kairos-prep:errorPolicy "fail" .

prep:tblRelationCdc a kairos-prep:CdcMapping ;
    kairos-prep:rawOperationColumn bronze:tblRelation_RelationID ;
    kairos-prep:rawUpdateTimestampColumn bronze:tblRelation_ModifiedDate ;
    kairos-prep:rawEffectiveTimestampColumn bronze:tblRelation_ModifiedDate ;
    kairos-prep:rawIngestionTimestampColumn bronze:tblRelation_ModifiedDate ;
    kairos-prep:rawSequenceColumn bronze:tblRelation_RelationID ;
    kairos-prep:operationCodeMap "*=snapshot" ;
    kairos-prep:normalizedOperationField prep:cdcOperation ;
    kairos-prep:normalizedUpdateTimestampField prep:sourceUpdatedAt ;
    kairos-prep:normalizedEffectiveTimestampField prep:sourceEffectiveAt ;
    kairos-prep:normalizedIngestionTimestampField prep:ingestedAt ;
    kairos-prep:normalizedSequenceField prep:cdcSequence .

prep:tblIdentifierPolicy a kairos-prep:PreparationPolicy ;
    kairos-prep:sourceTable bronze:tblIdentifier ;
    kairos-prep:prepMode "normalize" ;
    kairos-prep:schemaChangePolicy "fail" ;
    kairos-prep:recordKeyPolicy prep:tblIdentifierKey ;
    kairos-prep:physicalRename prep:tblIdentifierValueRename ;
    kairos-prep:typeConversion prep:tblIdentifierClientIdCast ;
    kairos-prep:cdcMapping prep:tblIdentifierCdc .

prep:tblIdentifierValueRename a kairos-prep:PhysicalRename ;
    kairos-prep:sourceColumn bronze:tblIdentifier_Value ;
    kairos-prep:targetColumnName "identifier_value_raw" .

prep:tblIdentifierClientIdCast a kairos-prep:TypeConversion ;
    kairos-prep:sourceColumn bronze:tblIdentifier_ClientID ;
    kairos-prep:targetType "string" ;
    kairos-prep:parsePolicy "integer-lexical" ;
    kairos-prep:errorPolicy "fail" .

prep:tblIdentifierCdc a kairos-prep:CdcMapping ;
    kairos-prep:rawOperationColumn bronze:tblIdentifier_IdentifierID ;
    kairos-prep:rawUpdateTimestampColumn bronze:tblIdentifier_ModifiedDate ;
    kairos-prep:rawEffectiveTimestampColumn bronze:tblIdentifier_ValidFrom ;
    kairos-prep:rawIngestionTimestampColumn bronze:tblIdentifier_ModifiedDate ;
    kairos-prep:rawSequenceColumn bronze:tblIdentifier_IdentifierID ;
    kairos-prep:operationCodeMap "*=snapshot" ;
    kairos-prep:normalizedOperationField prep:cdcOperation ;
    kairos-prep:normalizedUpdateTimestampField prep:sourceUpdatedAt ;
    kairos-prep:normalizedEffectiveTimestampField prep:sourceEffectiveAt ;
    kairos-prep:normalizedIngestionTimestampField prep:ingestedAt ;
    kairos-prep:normalizedSequenceField prep:cdcSequence .

prep:tblClientKey a kairos-prep:RecordKeyPolicy ;
    kairos-prep:sourceScope "adminpulse" ; kairos-prep:tableScope "tblClient" ;
    kairos-prep:recordKeyComponent bronze:tblClient_ClientID ;
    kairos-prep:recordKeyOutput prep:sourceRecordKey .
prep:tblClientPIIKey a kairos-prep:RecordKeyPolicy ;
    kairos-prep:sourceScope "adminpulse" ; kairos-prep:tableScope "tblClientPII" ;
    kairos-prep:recordKeyComponent bronze:tblClientPII_ClientID ;
    kairos-prep:recordKeyOutput prep:sourceRecordKey .
prep:tblClientTypeKey a kairos-prep:RecordKeyPolicy ;
    kairos-prep:sourceScope "adminpulse" ; kairos-prep:tableScope "tblClientType" ;
    kairos-prep:recordKeyComponent bronze:tblClientType_TypeCode ;
    kairos-prep:recordKeyOutput prep:sourceRecordKey .
prep:tblRelationKey a kairos-prep:RecordKeyPolicy ;
    kairos-prep:sourceScope "adminpulse" ; kairos-prep:tableScope "tblRelation" ;
    kairos-prep:recordKeyComponent bronze:tblRelation_RelationID ;
    kairos-prep:recordKeyOutput prep:sourceRecordKey .
prep:tblIdentifierKey a kairos-prep:RecordKeyPolicy ;
    kairos-prep:sourceScope "adminpulse" ; kairos-prep:tableScope "tblIdentifier" ;
    kairos-prep:recordKeyComponent bronze:tblIdentifier_IdentifierID ;
    kairos-prep:recordKeyOutput prep:sourceRecordKey .

prep:sourceRecordKey a kairos-prep:PreparedColumn ;
    kairos-prep:targetColumnName "_source_record_key" ;
    kairos-prep:targetType "string" .

prep:cdcOperation a kairos-prep:PreparedColumn ;
    kairos-prep:targetColumnName "_cdc_operation" ;
    kairos-prep:targetType "string" .

prep:sourceEffectiveAt a kairos-prep:PreparedColumn ;
    kairos-prep:targetColumnName "_source_effective_at" ;
    kairos-prep:targetType "timestamp" .

prep:ingestedAt a kairos-prep:PreparedColumn ;
    kairos-prep:targetColumnName "_ingested_at" ;
    kairos-prep:targetType "timestamp" .

prep:cdcSequence a kairos-prep:PreparedColumn ;
    kairos-prep:targetColumnName "_cdc_sequence" ;
    kairos-prep:targetType "string" .
