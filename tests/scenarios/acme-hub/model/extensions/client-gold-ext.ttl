@prefix acme: <https://acme.example/ontology/client#> .
@prefix kairos-ext: <https://kairos.cnext.eu/ext#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://acme.example/ontology/client>
    a owl:Ontology ;
    rdfs:label "ACME Client Gold product policy"@en ;
    rdfs:comment "Governed profile with explicit Silver and security bindings."@en ;
    owl:versionInfo "2.0.0" ;
    kairos-ext:goldSchema "gold" ;
    kairos-ext:goldProductProfile "dimensional-powerbi-v1" ;
    kairos-ext:securityPolicy acme:ClientSecurity ;
    kairos-ext:namingConvention "camel-to-snake" .

acme:ClientSecurity a kairos-ext:SecurityPolicy ;
    kairos-ext:entitlementSource "governed-client-entitlements" ;
    kairos-ext:identityMapping "model-user-to-entitlement-subject" ;
    kairos-ext:rolePolicy "ClientReader", "ClientProtected" ;
    kairos-ext:filterDirection "entitlement-to-product" ;
    kairos-ext:securityBinding "Client.client_id=ClientReader:RLS",
                               "Client.email=ClientProtected:OLS" ;
    kairos-ext:positiveSecurityTest "authorized-client-reader" ;
    kairos-ext:negativeSecurityTest "unauthorized-client-reader" ;
    kairos-ext:securityTestEvidence "security-run:client-access-v1" ;
    kairos-ext:failClosed true .

acme:Client
    kairos-ext:goldTableType "dimension" ;
    kairos-ext:goldTableName "dim_client" ;
    kairos-ext:goldSourceModel "client" ;
    kairos-ext:goldSourceVersion "1.0.0" ;
    kairos-ext:dimensionExposure "dual" ;
    kairos-ext:dimensionVersionBinding "current" ;
    kairos-ext:perspective "ClientNavigation" .
