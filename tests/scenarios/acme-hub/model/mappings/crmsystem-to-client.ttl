@prefix acme: <https://acme.example/ontology/client#> .
@prefix bronze-crm: <https://acme.example/bronze/crmsystem#> .
@prefix kairos-map: <https://kairos.cnext.eu/mapping#> .
@prefix map: <https://acme.example/mapping/crmsystem-to-client#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

map:column__Customers_CustCode__to__clientId a kairos-map:ColumnMapping ;
    kairos-map:matchType "exactMatch" ;
    kairos-map:sourceColumn bronze-crm:Customers_CustCode ;
    kairos-map:targetProperty acme:clientId .

map:column__Customers_CustEmail__to__email a kairos-map:ColumnMapping ;
    kairos-map:matchType "exactMatch" ;
    kairos-map:sourceColumn bronze-crm:Customers_CustEmail ;
    kairos-map:targetProperty acme:email .

map:column__Customers_CustName__to__clientName a kairos-map:ColumnMapping ;
    kairos-map:matchType "exactMatch" ;
    kairos-map:sourceColumn bronze-crm:Customers_CustName ;
    kairos-map:targetProperty acme:clientName .

map:table__Customers__to__CorporateClient a kairos-map:TableMapping ;
    kairos-map:mappingType "direct" ;
    kairos-map:matchType "exactMatch" ;
    kairos-map:sourceTable bronze-crm:Customers ;
    kairos-map:targetClass acme:CorporateClient .

bronze-crm:Customers skos:exactMatch acme:CorporateClient .

bronze-crm:Customers_CustCode skos:exactMatch acme:clientId .

bronze-crm:Customers_CustEmail skos:exactMatch acme:email .

bronze-crm:Customers_CustName skos:exactMatch acme:clientName .
