map:column__tblClientPII_NationalID__to__nationalId__upper a kairos-map:FunctionExpression ;
    kairos-map:arguments ( map:column__tblClientPII_NationalID__to__nationalId__upper_input__source ) ;
    kairos-map:determinism "deterministic" ;
    kairos-map:function "upper" ;
    kairos-map:nullPolicy "propagate" ;
    kairos-map:nullable true ;
    kairos-map:outputType "string" ;
    kairos-map:requiresCapability "scalar-function" .

