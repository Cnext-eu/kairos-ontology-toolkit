version: 5
name: {repo_name}
# Target platform. Names the engine, not the vendor: Fabric Warehouse is T-SQL and
# Fabric Lakehouse is Spark SQL, and the compiler emits different SQL for each.
# Supported: fabric-warehouse | databricks. Set it with `init --adapter`.
adapter: {adapter}
# Optional: declare which hub modes are served. When absent or empty, ALL modes
# are served (backward compatible). Mode-specific managed imports whose
# activation mode is not in this list are skipped during validation and
# import-plan building. Example values: interactive, autopilot, dataplatform.
# modes_served:
#   - interactive
#   - dataplatform

# Diagram layout (issue #855). Every generated Mermaid diagram opens with frontmatter
# selecting the ELK layout engine, which routes edges orthogonally and clusters stub
# nodes; renderers without ELK (GitHub, Azure DevOps wikis) fall back to dagre with a
# console warning and no error. Set `none` only for a renderer older than Mermaid 10.5,
# which rejects frontmatter outright. Hub-wide by design: one hub's diagrams must not
# disagree about their own layout.
# projections:
#   mermaid_layout: elk

# Concept guide sample values (DD-232). `project --target ddd` writes
# architecture/ddd/concept-guide.md and ubiquitous-language.ttl for every hub. The guide
# can quote the import step's redacted `kairos-bronze:sampleValues` beside each mapped
# property, but the lane is tracked and samples can carry personal data even after
# redaction, so they are OFF unless the hub decides otherwise here.
# projections:
#   concept_guide:
#     samples: false
#     max_samples: 3

# Gold semantic-model connection. Required as soon as a domain authors a Gold
# product profile: `emit-gold` fails closed with
# `gold.direct-lake-connection-missing` without it, because a Direct Lake model
# binds through a named expression that embeds the workspace and item GUIDs.
# `item_id` is the Fabric Warehouse dbt writes Gold into (DD-239): Direct Lake reads
# its gold_* Delta tables through OneLake. `lakehouse_id` is a deprecated alias.
# Declare every environment the model may be promoted into -- the projector emits
# a root `parameter.yml` so fabric-cicd rewrites these at deploy time.
# `environments` is a MAPPING keyed by environment name -- not a list of `- name:`
# entries. Replace every <...> below with a real GUID: the all-zero placeholder is
# GUID-shaped, so accepting it would emit a well-formed model pointing at a OneLake
# path that resolves to nothing. `emit-gold` rejects it for that reason.
#
# The values here are the hub's own defaults, baked into the emitted TMDL. A
# dataplatform that owns the target infrastructure can override them per environment
# at deploy time without the hub declaring those GUIDs at all -- see CICD.md,
# "Fabric and Power BI".
# gold:
#   direct_lake_connection:
#     default_environment: dev
#     environments:
#       dev:
#         workspace_id: <dev workspace GUID>
#         item_id: <dev Warehouse GUID>
#       prod:
#         workspace_id: <prod workspace GUID>
#         item_id: <prod Warehouse GUID>

# Gold products (issue #744). Optional. An analytical product follows a business
# process, not a modelling boundary: a fact from one domain joined to conformed
# dimensions from several others. Declare one here and `emit-gold <product>`
# compiles every listed domain and shapes them into ONE semantic model, so a
# cross-domain foreign key resolves instead of leaving a dead surrogate-key column.
#
# Without this block nothing changes: every Gold-configured domain stays its own
# product under its own name, with the same emitted paths as before.
#
# `name` is used verbatim in artifact paths, so lower-case, digits and hyphens only.
# `display_name` is optional and becomes the Fabric item name (default: PascalCase
# of `name`). Every listed domain must author its own `<domain>-gold-ext.ttl`
# declaring the tables it owns.
#
# A domain belongs to at most one product UNLESS it is listed under `shared_domains`
# (issue #829, DD-228) -- a conformed dimension such as `party` that several products
# slice by. A shared domain's tables are materialized once, by that domain's own
# `compile --emit`, into its own `goldSchema`; each product that lists it simply reads
# them. `emit-gold` prints which tables a product builds and which it reads.
#
# Declare sharing explicitly rather than relying on a domain happening to have no
# facts: adding the first fact to an inferred-shared domain would silently
# re-materialize all of its tables in every consuming product.
#
# A cross-domain relationship reaches the compiler only through a DD-138
# `externalReference` in the child's EntityBinding; without one the compile blocks
# on `safety.relationship-endpoint` long before Gold sees it.
# gold:
#   shared_domains: [party, reference-data]
#   products:
#     - name: bookings-overview
#       display_name: Bookings Overview
#       domains: [booking, party, reference-data]
#     - name: financial-performance
#       domains: [billing, party, reference-data]
