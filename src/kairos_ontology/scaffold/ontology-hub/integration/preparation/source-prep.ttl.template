@prefix prep: <https://example.com/preparation/source#> .
@prefix bronze: <https://example.com/bronze/source#> .
@prefix kairos-prep: <https://kairos.cnext.eu/preparation#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://example.com/preparation/source> a owl:Ontology ;
    rdfs:label "Source preparation policy"@en ;
    rdfs:comment "Replace this namespace and declare one PreparationPolicy for every mapped Bronze table."@en ;
    owl:imports <https://kairos.cnext.eu/preparation>,
                <https://example.com/bronze/source> ;
    owl:versionInfo "1.0.0" .

prep:tablePolicy a kairos-prep:PreparationPolicy ;
    kairos-prep:sourceTable bronze:table ;
    kairos-prep:prepMode "passthrough" ;
    kairos-prep:schemaChangePolicy "fail" ;
    kairos-prep:recordKeyPolicy prep:tableRecordKey .

prep:tableRecordKey a kairos-prep:RecordKeyPolicy ;
    kairos-prep:sourceScope "source" ;
    kairos-prep:tableScope "table" ;
    kairos-prep:recordKeyComponent bronze:table_id ;
    kairos-prep:recordKeyOutput prep:sourceRecordKey .

prep:sourceRecordKey a kairos-prep:PreparedColumn ;
    kairos-prep:targetColumnName "_source_record_key" ;
    kairos-prep:targetType "string" .

# Incremental/SCD consumers require prepMode "normalize" plus one complete CdcMapping:
# raw operation/update/effective/ingestion/sequence fields, explicit operationCodeMap,
# and normalized _cdc_operation, _source_updated_at, _source_effective_at,
# _ingested_at, and sequence outputs. See source-prep.example.ttl.
