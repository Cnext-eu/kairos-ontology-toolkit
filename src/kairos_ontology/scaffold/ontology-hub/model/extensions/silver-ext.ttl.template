# Silver policy extension for the {DOMAIN} ontology
#
# Fresh hubs author explicit v1 identity, lineage, history, relationship, and
# data-quality policy here. Keep physical policy out of the domain ontology.

@prefix kairos-ext: <https://kairos.cnext.eu/ext#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

@prefix domain: <{DOMAIN_URI}> .

<{DOMAIN_EXTENSION_URI}> a owl:Ontology ;
    rdfs:label "{DOMAIN} Silver Extension"@en ;
    rdfs:comment "Silver identity, lineage, history, relationship, and quality policy for {DOMAIN}."@en ;
    owl:imports <{DOMAIN_ONTOLOGY_URI}> .

<{DOMAIN_ONTOLOGY_URI}>
    kairos-ext:silverSchema "silver_{domain}" ;
    kairos-ext:namingConvention "camel-to-snake" .

# ---------------------------------------------------------------------------
# Materialized entity authority
# ---------------------------------------------------------------------------
#
# Every materialized class declares its grain, identity strategy, entity-instance
# IRI policy, key scope, prepared source identity, change detection, and lineage.
# An entity-instance IRI is a semantic identifier; it is not a source key or
# physical warehouse join key.
#
# domain:MyEntity
#     kairos-ext:silverTableName "my_entity" ;
#     kairos-ext:businessGrain "one governed entity record" ;
#     kairos-ext:identityStrategy "source-scoped-immutable-key" ;
#     kairos-ext:entityInstanceIriPolicy "emit" ;
#     kairos-ext:keyScope "source-table" ;
#     kairos-ext:sourceIdentity domain:PreparedSourceRecordKey ;
#     kairos-ext:changeDetectionStrategy "compare-columns" ;
#     kairos-ext:lineagePolicy "source-record-and-load" ;
#     kairos-ext:scdType "1" ;
#     kairos-ext:incrementalPolicy domain:MyIncrementalPolicy .
#
# Valid identity strategies are business-key, source-scoped-immutable-key,
# deterministic-integration-key, externally-mastered-identifier, and
# surrogate-only. business-key, deterministic-integration-key, and
# externally-mastered-identifier require an explicitly mapped naturalKey.
# surrogate-only forbids naturalKey and requires reconciliationLimitation.
# deterministic-integration-key additionally requires multiple sourceIdentity
# values and an approved exactly-equivalent multiSourcePolicy. Externally mastered
# identifiers are routed to MDM; core does not match or apply survivorship.
# entityInstanceIriPolicy is explicitly "emit" or "omit". Single-source entities
# omit drivingSource (the effective mode is deterministically only-source);
# multi-contributor entities declare one drivingSource from sourceIdentity.

# ---------------------------------------------------------------------------
# History and incremental execution authority
# ---------------------------------------------------------------------------
#
# SCD2 entities declare whether history represents business-valid time or load
# history. Incremental entities link a complete execution policy.
#
# domain:MyHistoricalEntity
#     kairos-ext:silverTableName "my_historical_entity" ;
#     kairos-ext:businessGrain "one governed entity version" ;
#     kairos-ext:identityStrategy "business-key" ;
#     kairos-ext:entityInstanceIriPolicy "emit" ;
#     kairos-ext:keyScope "domain" ;
#     kairos-ext:sourceIdentity domain:PreparedSourceRecordKey ;
#     kairos-ext:naturalKey "businessId" ;
#     kairos-ext:changeDetectionStrategy "canonical-hash" ;
#     kairos-ext:hashPolicy domain:MyHashPolicy ;
#     kairos-ext:lineagePolicy "source-record-and-load" ;
#     kairos-ext:scdType "2" ;
#     kairos-ext:scd2TimeBasis "business-valid" ;
#     kairos-ext:incrementalPolicy domain:MyIncrementalPolicy .
#
# domain:MyIncrementalPolicy a kairos-ext:IncrementalPolicy ;
#     kairos-ext:mergeIdentity "_source_record_key" ;
#     kairos-ext:cdcOperation "_cdc_operation" ;
#     kairos-ext:sourceUpdateTimestamp "_source_updated_at" ;
#     kairos-ext:sourceEffectiveTimestamp "_source_effective_at" ;
#     kairos-ext:ingestionTimestamp "_ingested_at" ;
#     kairos-ext:totalOrderTieBreaker "_source_record_key" ;
#     kairos-ext:lookbackWindow "7 days" ;
#     kairos-ext:hardDeletePolicy "tombstone" ;
#     kairos-ext:softDeletePolicy "apply-operation" ;
#     kairos-ext:lateArrivalPolicy "reconcile-with-lookback" ;
#     kairos-ext:correctionPolicy "replace-by-total-order" ;
#     kairos-ext:replayPolicy "idempotent-merge" ;
#     kairos-ext:backfillPolicy "full-rebuild-approved" ;
#     kairos-ext:schemaChangePolicy "fail" .
#
# domain:MyHashPolicy a kairos-ext:HashPolicy ;
#     kairos-ext:hashContractVersion "1" ;
#     kairos-ext:hashAlgorithm "SHA-256" ;
#     kairos-ext:hashInput ( domain:propertyOne domain:propertyTwo ) ;
#     kairos-ext:hashNullRepresentation "typed-length-delimited-null" .
#
# Every materialized FK declares mode, cardinality, all failure actions, and
# change-detection participation. As-of is always UTC/microsecond and [from, to).
#
# domain:referencesParent
#     kairos-ext:silverForeignKey true ;
#     kairos-ext:silverForeignKeyTemporalMode "as-of" ;
#     kairos-ext:silverForeignKeyAsOfColumn "_source_effective_at" ;
#     kairos-ext:silverForeignKeyInterval "closed-open" ;
#     kairos-ext:silverForeignKeyTimeZone "UTC" ;
#     kairos-ext:silverForeignKeyPrecision "microsecond" ;
#     kairos-ext:silverForeignKeyCardinality "exactly-one" ;
#     kairos-ext:silverForeignKeyMissingPolicy "quarantine" ;
#     kairos-ext:silverForeignKeyAmbiguousPolicy "fail" ;
#     kairos-ext:silverForeignKeyLateParentPolicy "restate" ;
#     kairos-ext:silverForeignKeyChangeDetection true .

