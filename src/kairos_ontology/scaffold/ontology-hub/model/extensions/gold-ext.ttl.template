# Gold product policy extension for the {DOMAIN} ontology
#
# Fresh hubs author an explicit v1 dimensional Power BI product profile here:
# table roles, governed measures, calendar, incremental execution, and security.

@prefix kairos-ext: <https://kairos.cnext.eu/ext#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

@prefix domain: <{DOMAIN_URI}> .

<{DOMAIN_EXTENSION_URI}> a owl:Ontology ;
    rdfs:label "{DOMAIN} Gold Extension"@en ;
    rdfs:comment "Governed dimensional Power BI product policy for {DOMAIN}."@en ;
    owl:imports <{DOMAIN_ONTOLOGY_URI}> .

<{DOMAIN_ONTOLOGY_URI}>
    kairos-ext:goldSchema "gold_{domain}" ;
    kairos-ext:goldProductProfile "dimensional-powerbi-v1" ;
    kairos-ext:namingConvention "camel-to-snake" .

# ---------------------------------------------------------------------------
# Explicit table and fact/dimension roles
# ---------------------------------------------------------------------------
#
# Every included Gold class declares goldTableType. Facts also declare grain,
# fact behavior, dimension-version binding, and a complete incremental policy.
# Dimensions declare the history exposure presented to consumers.
#
# domain:MyFact
#     kairos-ext:goldTableType "fact" ;
#     kairos-ext:goldTableName "fact_my_event" ;
#     kairos-ext:goldSourceModel "my_event" ;
#     kairos-ext:goldSourceVersion "1.0.0" ;
#     kairos-ext:factGrain "one business event" ;
#     kairos-ext:factType "transaction" ;
#     kairos-ext:dimensionVersionBinding "as-of-event-date" ;
#     kairos-ext:incrementalPolicy domain:MyFactIncremental .
#
# domain:MyDimension
#     kairos-ext:goldTableType "dimension" ;
#     kairos-ext:goldTableName "dim_my_entity" ;
#     kairos-ext:goldSourceModel "my_entity" ;
#     kairos-ext:goldSourceVersion "1.0.0" ;
#     kairos-ext:dimensionExposure "dual" ;
#     kairos-ext:dimensionVersionBinding "current" .
#
# domain:MyBridge
#     kairos-ext:goldTableType "bridge" ;
#     kairos-ext:goldTableName "bridge_my_relationship" ;
#     kairos-ext:goldSourceModel "my_relationship" ;
#     kairos-ext:goldSourceVersion "1.0.0" ;
#     kairos-ext:bridgeGrain "one relationship allocation" ;
#     kairos-ext:bridgeEndpoint domain:MyFact, domain:MyDimension ;
#     kairos-ext:bridgeEndpointBinding "MyFact=my_fact_sk",
#                                      "MyDimension=my_dimension_sk" ;
#     kairos-ext:bridgeCardinality "many-to-many" ;
#     kairos-ext:bridgeAllocationSemantics "no-allocation-approved" .

