# ---------------------------------------------------------------------------
# First-class governed measures
# ---------------------------------------------------------------------------
#
# Link each Measure resource from the Gold product ontology. Intent measures may
# capture a reviewed business definition before DAX and dependencies are ready.
# Provisional, validated, and approved measures require both.
#
# <{DOMAIN_ONTOLOGY_URI}> kairos-ext:measure domain:TotalAmount .
#
# domain:TotalAmount a kairos-ext:Measure ;
#     kairos-ext:measureId "{domain}.total-amount" ;
#     kairos-ext:measureDefinition "Sum of governed amounts in the active filter context." ;
#     kairos-ext:measureExpression "SUM([amount])" ;
#     kairos-ext:measureColumnDependency domain:amount ;
#     kairos-ext:measureLifecycleState "approved" ;
#     kairos-ext:measureDataType "decimal" ;
#     kairos-ext:measureFormatString "#,##0.00" ;
#     kairos-ext:measureFolder "Finance" ;
#     kairos-ext:measureOwnerRole "Finance Data Owner" ;
#     kairos-ext:measureValidationTest "total-amount-reconciliation" ;
#     kairos-ext:measureValidationEvidence "dq-run:total-amount-v1" .

