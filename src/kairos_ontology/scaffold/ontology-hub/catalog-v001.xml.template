<?xml version="1.0" encoding="UTF-8"?>
<!--
  Local catalog for {company_name} domain ontologies.
  Maps ontology URIs to local files so owl:imports resolve without network access.

  Usage:
    kairos-ontology validate
    kairos-ontology compile <domain> (check mode)

  The toolkit auto-discovers this file at ontology-hub/catalog-v001.xml.
  Reference models (FIBO, blueprints, archetypes, patterns) are resolved
  automatically from the installed kairos-ontology-referencemodels package.
  Do NOT add a <nextCatalog> entry here — the toolkit overlays the package
  catalog at runtime via CatalogResolver.with_reference_models().
-->
<catalog xmlns="urn:oasis:names:tc:entity:xmlns:xml:catalog">

  <!-- ============================================================
       Domain ontologies — add one <uri> per domain
       ============================================================ -->

  <!--
  <uri name="https://{company_domain}/ont/customer"
       uri="model/ontologies/customer.ttl"/>
  -->

  <!-- Shared foundation ontology (imported by thin domain ontologies).
       Uncomment if your domain ontologies owl:imports the foundation. -->
  <!--
  <uri name="https://{company_domain}/ont/_foundation"
       uri="model/ontologies/_foundation.ttl"/>
  -->

</catalog>
