# Dataplatform dbt Project
#
# This project consumes ontology-generated dbt models from the ontology-hub
# via dbt deps. It provides the physical source bindings for your bronze
# lakehouse/warehouse tables.
#
# See: https://github.com/Cnext-eu/kairos-ontology-toolkit

name: '{PROJECT_NAME}'
version: '1.0.0'
profile: '{PROJECT_NAME}'

# Ontology-generated models are pulled in as a dbt package
# See packages.yml for the ontology-hub reference

model-paths: ["models"]
analysis-paths: ["analyses"]
test-paths: ["tests"]
seed-paths: ["seeds"]
macro-paths: ["macros"]
snapshot-paths: ["snapshots"]

clean-targets:
  - "target"
  - "dbt_packages"

# Custom schema for this project's own models. dbt prefixes it with the target's
# `schema`, so the environment is chosen by `--target`, not here.
models:
  +schema: silver

# Redacted source samples emitted by `kairos-ontology extract-schema --emit-seed`
# (seeds/<system>__<table>__sample.csv) get their own schema/tags, distinct from
# any hand-authored reference seeds this project may add later.
seeds:
  +schema: 'bronze_samples'
  +tags: ['source-sample']

# What dbt does not know about an environment, for the Kairos deploy (DD-255). Keys are
# the profiles.yml target names; each value is a Fabric workspace name or GUID. Both
# default to the workspace of the Gold Warehouse the target writes to, so a platform
# with one workspace per environment needs none of this. `gold_workspace` only narrows
# the search when two workspaces hold a Warehouse with the same endpoint and name.
# Check with: uv run kairos-ontology resolve-environment --target uat
# vars:
#   kairos:
#     environments:
#       dev:
#         models_workspace: my-models-dev     # where the semantic models are published
#         reports_workspace: my-reports-dev   # where authored reports are published
#       uat:
#         models_workspace: my-models-uat
#       prod:
#         models_workspace: my-models-prod
