# dbt profiles -- the environment authority of this dataplatform (DD-255)
#
# COMMIT THIS FILE. Each output below is one environment: `dbt build --target uat` builds
# UAT, and the same name is the GitHub Environment the deploy runs in and the key Kairos
# binds the Power BI models with. `kairos-ontology resolve-environment --target uat` shows
# what a deploy derives from it -- for Fabric, the Gold Warehouse is the one whose SQL
# endpoint and name are the target's `server` and `database`.
#
# No secrets go in this file: credentials come from the environment (`env_var()` or the
# adapter's own variables). Endpoints and database names are not secrets.
#
# dbt finds this file in the project directory without flags. A personal override can go
# in .dbt/profiles.yml (gitignored) with `--profiles-dir .dbt`; PR CI writes its own
# placeholder `ci` profile there.
#
# Environment names are case-insensitive and lowercase (`dev`, `uat`, `prod`). To add
# one, add an output here, then follow "Add an environment" in CICD.md.
#
# This file was generated for the platform you passed to `init-dataplatform
# --platform <platform>`: its block below is active. The other supported platform is kept
# as a commented reference block in case you switch platforms later.
#
# Fabric Lakehouse is deliberately absent: it is Spark SQL, the compiler has no profile
# for it, and the block that used to sit here was a Warehouse connection under a
# Lakehouse label (DD-215).
#
# See: https://docs.getdbt.com/docs/core/connect-data-platform

{PROJECT_NAME}:
  target: dev
  outputs:


# --- PLATFORM: fabric-warehouse ---
    # Microsoft Fabric Warehouse
    # Requires: pip install dbt-fabric
    #
    # `authentication: environment` (#761): dbt-fabric 1.11 reads the service principal
    # from the standard Azure SDK variables, so no tenant/client keys go in this file.
    # Set these before running dbt:
    #   AZURE_TENANT_ID, AZURE_CLIENT_ID, AZURE_CLIENT_SECRET
    # Accepted dbt-fabric 1.11 spellings: environment, ActiveDirectoryDefault, cli,
    # ActiveDirectoryServicePrincipal. The last one appends `Authority Id=` to the
    # connection string, which the mssql-python driver rejects, and the bare
    # `ServicePrincipal` spelling is not accepted at all ("Unsupported authentication
    # method") -- so `environment` is the one that works on this driver stack.
    # The deploy workflow sets DBT_FABRIC_AUTHENTICATION=cli when its GitHub Environment
    # holds no AZURE_CLIENT_SECRET, using the federated `azure/login` session instead
    # (DD-256). Locally, unset, it stays `environment`.
    #
    # One Fabric workspace (or at least one Warehouse) per environment.
    # @config
    # dev:
    #   type: fabric
    #   driver: "ODBC Driver 18 for SQL Server"
    #   server: "{your-dev-workspace}.datawarehouse.fabric.microsoft.com"
    #   database: "{your-warehouse-name}"
    #   schema: "dbo"
    #   authentication: "{{ env_var('DBT_FABRIC_AUTHENTICATION', 'environment') }}"
    # uat:
    #   type: fabric
    #   driver: "ODBC Driver 18 for SQL Server"
    #   server: "{your-uat-workspace}.datawarehouse.fabric.microsoft.com"
    #   database: "{your-warehouse-name}"
    #   schema: "dbo"
    #   authentication: "{{ env_var('DBT_FABRIC_AUTHENTICATION', 'environment') }}"
    # prod:
    #   type: fabric
    #   driver: "ODBC Driver 18 for SQL Server"
    #   server: "{your-prod-workspace}.datawarehouse.fabric.microsoft.com"
    #   database: "{your-warehouse-name}"
    #   schema: "dbo"
    #   authentication: "{{ env_var('DBT_FABRIC_AUTHENTICATION', 'environment') }}"
    # @endconfig
# --- END PLATFORM ---

# --- PLATFORM: databricks ---
    # Databricks (Unity Catalog)
    # Requires: pip install dbt-databricks
    # @config
    # dev:
    #   type: databricks
    #   catalog: "{your-catalog}"
    #   schema: "silver"
    #   host: "{workspace-url}.azuredatabricks.net"
    #   http_path: "/sql/1.0/warehouses/{warehouse-id}"
    #   token: "{{ env_var('DBT_DATABRICKS_TOKEN') }}"
    # uat:
    #   type: databricks
    #   catalog: "{your-uat-catalog}"
    #   schema: "silver"
    #   host: "{workspace-url}.azuredatabricks.net"
    #   http_path: "/sql/1.0/warehouses/{warehouse-id}"
    #   token: "{{ env_var('DBT_DATABRICKS_TOKEN') }}"
    # prod:
    #   type: databricks
    #   catalog: "{your-prod-catalog}"
    #   schema: "silver"
    #   host: "{workspace-url}.azuredatabricks.net"
    #   http_path: "/sql/1.0/warehouses/{warehouse-id}"
    #   token: "{{ env_var('DBT_DATABRICKS_TOKEN') }}"
    # @endconfig
# --- END PLATFORM ---
