# dbt Profile Configuration — Example
#
# Copy this file to .dbt/profiles.yml and fill in your connection details.
# Run dbt with: dbt build --profiles-dir .dbt
# Or set the env var:
#   PowerShell: $env:DBT_PROFILES_DIR = ".dbt"
#   bash/zsh:   export DBT_PROFILES_DIR=.dbt
#
# The .dbt/profiles.yml file is gitignored to keep secrets out of version control.
#
# This example was generated for the platform you passed to `init-dataplatform
# --platform <platform>`: its block below is active (uncommented) under `dev:`.
# The other supported platform is kept below as a commented reference block in case
# you switch platforms later — just comment out the active block and uncomment the
# one you want instead.
#
# Fabric Lakehouse is deliberately absent: it is Spark SQL, the compiler has no
# profile for it, and the block that used to sit here was a Warehouse connection
# under a Lakehouse label (DD-215).
#
# See: https://docs.getdbt.com/docs/core/connect-data-platform

{PROJECT_NAME}:
  target: dev
  outputs:


# --- PLATFORM: fabric-warehouse ---
    # Microsoft Fabric Warehouse
    # Requires: pip install dbt-fabric
    #
    # `authentication: environment` (#761): dbt-fabric 1.11 reads the service principal
    # from the standard Azure SDK variables, so no tenant/client keys go in this file.
    # Set these before running dbt (same names deployment-settings.json.example lists):
    #   AZURE_TENANT_ID, AZURE_CLIENT_ID, AZURE_CLIENT_SECRET
    # Accepted dbt-fabric 1.11 spellings: environment, ActiveDirectoryDefault, cli,
    # ActiveDirectoryServicePrincipal. The last one appends `Authority Id=` to the
    # connection string, which the mssql-python driver rejects, and the bare
    # `ServicePrincipal` spelling is not accepted at all ("Unsupported authentication
    # method") -- so `environment` is the one that works on this driver stack.
    # @config
    # dev:
    #   type: fabric
    #   driver: "ODBC Driver 18 for SQL Server"
    #   server: "{your-workspace}.datawarehouse.fabric.microsoft.com"
    #   database: "{your-warehouse-name}"
    #   schema: "dbo"
    #   authentication: environment
    # @endconfig
    # --- Promotion targets (uncomment/adjust for a multi-environment setup,
    # e.g. one Fabric workspace per environment) — run with: dbt run --target uat
    # uat:
    #   type: fabric
    #   driver: "ODBC Driver 18 for SQL Server"
    #   server: "{your-uat-workspace}.datawarehouse.fabric.microsoft.com"
    #   database: "{your-warehouse-name}"
    #   schema: "dbo"
    #   authentication: environment
    # prod:
    #   type: fabric
    #   driver: "ODBC Driver 18 for SQL Server"
    #   server: "{your-prod-workspace}.datawarehouse.fabric.microsoft.com"
    #   database: "{your-warehouse-name}"
    #   schema: "dbo"
    #   authentication: environment
# --- END PLATFORM ---

# --- PLATFORM: databricks ---
    # Databricks (Unity Catalog)
    # Requires: pip install dbt-databricks
    # @config
    # dev:
    #   type: databricks
    #   catalog: "{your-catalog}"
    #   schema: "silver"
    #   host: "{workspace-url}.azuredatabricks.net"
    #   http_path: "/sql/1.0/warehouses/{warehouse-id}"
    #   token: "{{ env_var('DBT_DATABRICKS_TOKEN') }}"
    # @endconfig
    # --- Promotion targets (uncomment/adjust for a multi-environment setup)
    # — run with: dbt run --target uat
    # uat:
    #   type: databricks
    #   catalog: "{your-uat-catalog}"
    #   schema: "silver"
    #   host: "{workspace-url}.azuredatabricks.net"
    #   http_path: "/sql/1.0/warehouses/{warehouse-id}"
    #   token: "{{ env_var('DBT_DATABRICKS_TOKEN') }}"
    # prod:
    #   type: databricks
    #   catalog: "{your-prod-catalog}"
    #   schema: "silver"
    #   host: "{workspace-url}.azuredatabricks.net"
    #   http_path: "/sql/1.0/warehouses/{warehouse-id}"
    #   token: "{{ env_var('DBT_DATABRICKS_TOKEN') }}"
# --- END PLATFORM ---
