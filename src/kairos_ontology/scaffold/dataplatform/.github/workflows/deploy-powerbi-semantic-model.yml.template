name: Deploy Power BI Semantic Model

# DD-206 §8/§12 items 7, 9: this workflow is read-only over item CONTENT -- extract,
# verify, deploy. TMDL/PBIP normalization happens once, in the hub's Gold emission,
# before the archive is checksummed; nothing here rewrites the archive, its checksum,
# or any TMDL/PBIP file. The one exception is deploy-time parameterisation of the
# extracted `parameter.yml`, which is this side's job by design (issue #662) and is
# logged before/after. Every input below must verify before extraction (fail closed),
# and deployment must not run ahead of the target environment's own dbt build.
on:
  workflow_dispatch:
    inputs:
      hub_release_tag:
        description: "Ontology-hub release tag containing powerbi-semantic-model.zip"
        required: true
        default: "{HUB_VERSION}"
      expected_hub_sha:
        description: "Full 40-character hub commit SHA the release tag must resolve to"
        required: true
      expected_archive_sha256:
        description: "SHA-256 of powerbi-semantic-model.zip recorded in the hub release evidence"
        required: true
      target_environment:
        description: "Fabric environment key (used by fabric-cicd parameterization)"
        required: true
        default: "DEV"
      dbt_build_run_id:
        description: >-
          Run ID of the workflow run that built dbt successfully in target_environment.
          GitHub Actions has no native `needs:`/`workflow_run` dependency across two
          independently workflow_dispatch-triggered workflows, so this is the documented
          manual-ordering convention (see CICD.md, "Fabric and Power BI"): the operator
          promoting dbt supplies the run ID of that success, and this workflow verifies
          it before deploying anything.
        required: true

permissions:
  contents: read
  actions: read
  id-token: write

env:
  HUB_ORG: "{ORG}"
  HUB_REPO: "{HUB_REPO}"

jobs:
  deploy:
    runs-on: ubuntu-latest

    steps:
      - uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      # §12 item 9: deploy only after the target environment's dbt build succeeded.
      # No dbt-build workflow ships from this template (it is scaffolded/maintained
      # separately); this only verifies the run the operator names actually succeeded.
      - name: Verify target environment's dbt build already succeeded
        env:
          GH_TOKEN: ${{ github.token }}
          RUN_ID: ${{ inputs.dbt_build_run_id }}
          TARGET_ENVIRONMENT: ${{ inputs.target_environment }}
        run: |
          CONCLUSION=$(gh run view "$RUN_ID" --repo "$GITHUB_REPOSITORY" --json conclusion -q .conclusion)
          if [ "$CONCLUSION" != "success" ]; then
            echo "::error::dbt_build_run_id $RUN_ID did not succeed (conclusion: ${CONCLUSION:-unknown})."
            echo "::error::Deploy the target environment's dbt build first, then re-run with its run ID."
            exit 1
          fi
          echo "Verified dbt build run $RUN_ID succeeded for $TARGET_ENVIRONMENT."

      # §8 dataplatform responsibility items 1-2: verify the tag resolves to the
      # expected hub SHA before anything is downloaded.
      - name: Verify hub release tag resolves to the expected hub SHA
        env:
          GH_TOKEN: ${{ secrets.HUB_REPO_TOKEN || github.token }}
          EXPECTED_HUB_SHA: ${{ inputs.expected_hub_sha }}
        run: |
          RESOLVED_SHA=$(gh api "repos/${HUB_ORG}/${HUB_REPO}/commits/${{ inputs.hub_release_tag }}" -q .sha)
          if [ "$RESOLVED_SHA" != "$EXPECTED_HUB_SHA" ]; then
            echo "::error::${{ inputs.hub_release_tag }} resolves to $RESOLVED_SHA, expected $EXPECTED_HUB_SHA."
            exit 1
          fi
          echo "Verified ${{ inputs.hub_release_tag }} resolves to $EXPECTED_HUB_SHA."

      - name: Download semantic model package from ontology-hub release
        env:
          GH_TOKEN: ${{ secrets.HUB_REPO_TOKEN || github.token }}
        run: |
          gh release download "${{ inputs.hub_release_tag }}" \
            --repo "${HUB_ORG}/${HUB_REPO}" \
            --pattern "powerbi-semantic-model.zip" \
            --output powerbi-semantic-model.zip

      # §8 dataplatform responsibility item 3: verify the archive's SHA-256 before
      # extraction. Fails closed -- a checksum mismatch must never reach fabric-cicd.
      - name: Verify archive SHA-256
        env:
          EXPECTED_ARCHIVE_SHA256: ${{ inputs.expected_archive_sha256 }}
        run: |
          ACTUAL_SHA256=$(sha256sum powerbi-semantic-model.zip | cut -d' ' -f1)
          if [ "$ACTUAL_SHA256" != "$EXPECTED_ARCHIVE_SHA256" ]; then
            echo "::error::powerbi-semantic-model.zip SHA-256 is $ACTUAL_SHA256, expected $EXPECTED_ARCHIVE_SHA256."
            exit 1
          fi
          echo "Verified powerbi-semantic-model.zip SHA-256: $ACTUAL_SHA256"

      - name: Unpack semantic model package
        run: |
          mkdir -p semantic-model
          unzip -q powerbi-semantic-model.zip -d semantic-model

      # DD-206 #12 item 10: TMDL/PBIP normalization happens once, in the hub's Gold
      # emission, before the archive is checksummed. This workflow never normalizes,
      # never rewrites item content (TMDL/PBIP), and never touches the .zip or its
      # verified checksum.
      #
      # Deploy-time parameterisation is a separate concern and IS this side's job:
      # `parameter.yml` exists precisely so one checksummed artifact can be promoted
      # between environments. The hub can only enumerate environments it declares
      # itself, which forced real Fabric GUIDs into a repo that is otherwise
      # infrastructure-agnostic (issue #662). The step below lets this repo supply its
      # own target instead. It rewrites only `replace_value[<target_environment>]` in
      # the already-extracted, already-verified `parameter.yml`, leaves `find_value`
      # exactly as the hub emitted it, and logs before/after so the change is auditable
      # in the run log. No config file, or no matching environment => clean no-op.
      - name: Apply dataplatform Direct Lake connection override
        env:
          TARGET_ENVIRONMENT: ${{ inputs.target_environment }}
        run: |
          uv run kairos-ontology apply-gold-connection \
            --package-dir semantic-model \
            --environment "$TARGET_ENVIRONMENT"

      - name: Azure login (service principal)
        uses: azure/login@v2
        with:
          client-id: ${{ secrets.AZURE_CLIENT_ID }}
          tenant-id: ${{ secrets.AZURE_TENANT_ID }}
          subscription-id: ${{ secrets.AZURE_SUBSCRIPTION_ID }}

      - name: Install fabric-cicd
        run: |
          pip install --upgrade pip
          pip install fabric-cicd azure-identity

      # `environment` selects one value per `find_replace` entry of the `parameter.yml`
      # that fabric-cicd reads from the root of `repository_directory`. For a Databricks
      # (directQuery) model the hub ships that file inside the release package, generated
      # from `gold.databricks_connection` in `kairos.yaml`; `target_environment` must be
      # one of the environment keys declared there -- or supplied by the override step
      # above via `.github/fabric/gold-connections.yml` -- or the rewrite is skipped and
      # the model keeps the default environment's warehouse.
      #
      # §8 dataplatform responsibility item 6: both Fabric item types the hub ships
      # (SemanticModel and Report) are deployed together.
      - name: Publish semantic model and report to Fabric workspace
        env:
          FABRIC_WORKSPACE_ID: ${{ secrets.FABRIC_WORKSPACE_ID }}
          TARGET_ENVIRONMENT: ${{ inputs.target_environment }}
        run: |
          python - <<'PY'
          import os
          from pathlib import Path

          from azure.identity import AzureCliCredential
          from fabric_cicd import FabricWorkspace, publish_all_items

          workspace_id = os.environ["FABRIC_WORKSPACE_ID"]
          target_env = os.environ["TARGET_ENVIRONMENT"]
          model_dir = Path("semantic-model").resolve()

          target_workspace = FabricWorkspace(
              workspace_id=workspace_id,
              environment=target_env,
              repository_directory=str(model_dir),
              item_type_in_scope=["SemanticModel", "Report"],
              token_credential=AzureCliCredential(),
          )

          publish_all_items(target_workspace)
          print(f"Published SemanticModel and Report items from: {model_dir}")
          PY
