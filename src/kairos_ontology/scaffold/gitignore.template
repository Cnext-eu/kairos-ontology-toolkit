# Node.js
node_modules/

# Generated projection output. Ignored by default, with an explicit allowlist for
# the release-relevant lanes DD-206 (Branching and Collaboration Guide) requires a
# hub release to publish from an exact commit: the dbt package a dataplatform pins
# by SHA, and the Power BI PBIP output a hub release packages and checksums. Every
# other projection target (neo4j, azure-search, a2ui, prompt, mdm, architecture/*,
# reports/details) stays ignored -- reports/details in particular can carry
# PII-adjacent validation detail, and the rest are alternate export targets, not
# part of the dbt+Power BI release lane. Track more only after a deliberate,
# per-hub review (see CICD.md), never by widening this default silently.
ontology-hub-publish/**
!ontology-hub-publish/**/
!ontology-hub-publish/**/.gitkeep
!ontology-hub-publish/medallion/dbt/**
!ontology-hub-publish/powerbi/**

# IDE
.vscode/
.idea/
*.swp

# Raw client evidence (toolkit-created convention). Matched as `**/.import/*` rather
# than `.import/` so the negation below can apply -- git never descends into a
# directory matched by a bare `dir/` pattern, so `.import/modeling/` could not
# otherwise be un-ignored (#591).
**/.import/*
# ...except toolkit-managed, structured records under .import/modeling/ (#591) --
# these are OKF-style records with their own provenance, not disposable exports.
!**/.import/modeling/

# Toolkit performance caches (analyse-sources/propose-alignment, ontology-closure parse
# cache) -- content-hash keyed, safe to delete anytime, never affects compiled output
.cache/

# OS
.DS_Store
Thumbs.db
