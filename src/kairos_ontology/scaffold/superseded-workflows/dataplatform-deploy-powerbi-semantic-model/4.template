name: Deploy Power BI Semantic Model

# DD-206 §8/§12 items 7, 9: this workflow is read-only over item CONTENT -- extract,
# verify, deploy. TMDL/PBIP normalization happens once, in the hub's Gold emission,
# before the archive is checksummed; nothing here rewrites the archive, its checksum,
# or any TMDL/PBIP file. The one exception is deploy-time parameterisation of the
# extracted `parameter.yml`, which is this side's job by design (issue #662) and is
# logged before/after. Every input below must verify before extraction (fail closed),
# and deployment must not run ahead of the target environment's own dbt build.
on:
  workflow_dispatch:
    inputs:
      hub_release_tag:
        description: "Ontology-hub release tag containing powerbi-semantic-model.zip"
        required: true
        default: "{HUB_VERSION}"
      expected_hub_sha:
        description: "Full 40-character hub commit SHA the release tag must resolve to"
        required: true
      expected_archive_sha256:
        description: "SHA-256 of powerbi-semantic-model.zip recorded in the hub release evidence"
        required: true
      target_environment:
        description: "Fabric environment key (used by fabric-cicd parameterization)"
        required: true
        default: "DEV"
      dbt_build_run_id:
        description: >-
          Run ID of the workflow run that built dbt successfully in target_environment.
          GitHub Actions has no native `needs:`/`workflow_run` dependency across two
          independently workflow_dispatch-triggered workflows, so this is the documented
          manual-ordering convention (see CICD.md, "Fabric and Power BI"): the operator
          promoting dbt supplies the run ID of that success, and this workflow verifies
          it before deploying anything.
        required: true
      run_bpa_advisory:
        description: >-
          After publishing, run the advisory Best Practice Analyzer notebook against the
          deployed model (DD-238). Never blocks the deploy; see CICD.md.
        type: boolean
        default: true

permissions:
  contents: read
  actions: read
  id-token: write

env:
  HUB_ORG: "{ORG}"
  HUB_REPO: "{HUB_REPO}"

jobs:
  deploy:
    runs-on: ubuntu-latest

    steps:
      - uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      # The connection-override step below runs `kairos-ontology` from this repo's
      # locked environment, exactly as pr-validate.yml does. Without these two steps it
      # failed with `uv: command not found` before anything was published (#983).
      - name: Install uv
        uses: astral-sh/setup-uv@v10.0.1
        with:
          # Same pin as pr-validate.yml: an unpinned version queries github.com's
          # "latest release" API, which 404s from a GitHub Enterprise Server host.
          version: "0.12.5"
          enable-cache: true

      - name: Install toolkit
        run: uv sync --locked

      # §12 item 9: deploy only after the target environment's dbt build succeeded.
      # No dbt-build workflow ships from this template (it is scaffolded/maintained
      # separately); this only verifies the run the operator names actually succeeded.
      - name: Verify target environment's dbt build already succeeded
        env:
          GH_TOKEN: ${{ github.token }}
          RUN_ID: ${{ inputs.dbt_build_run_id }}
          TARGET_ENVIRONMENT: ${{ inputs.target_environment }}
        run: |
          CONCLUSION=$(gh run view "$RUN_ID" --repo "$GITHUB_REPOSITORY" --json conclusion -q .conclusion)
          if [ "$CONCLUSION" != "success" ]; then
            echo "::error::dbt_build_run_id $RUN_ID did not succeed (conclusion: ${CONCLUSION:-unknown})."
            echo "::error::Deploy the target environment's dbt build first, then re-run with its run ID."
            exit 1
          fi
          echo "Verified dbt build run $RUN_ID succeeded for $TARGET_ENVIRONMENT."

      # Every `gh` call against the hub below is cross-repository. The default
      # GITHUB_TOKEN is scoped to *this* repository and cannot read a private sibling,
      # so falling back to it only moves the failure to a confusing "release not found"
      # later (#760). Fail here, by name, instead.
      - name: Verify HUB_REPO_TOKEN is configured
        env:
          HUB_REPO_TOKEN: ${{ secrets.HUB_REPO_TOKEN }}
        run: |
          if [ -z "${HUB_REPO_TOKEN:-}" ]; then
            echo "::error::HUB_REPO_TOKEN is not set; GITHUB_TOKEN cannot read a private sibling repository -- add a token with Contents:read on the hub repo as the HUB_REPO_TOKEN secret"
            exit 1
          fi
          echo "HUB_REPO_TOKEN is set."

      # §8 dataplatform responsibility items 1-2: verify the tag resolves to the
      # expected hub SHA before anything is downloaded.
      - name: Verify hub release tag resolves to the expected hub SHA
        env:
          GH_TOKEN: ${{ secrets.HUB_REPO_TOKEN }}
          EXPECTED_HUB_SHA: ${{ inputs.expected_hub_sha }}
        run: |
          RESOLVED_SHA=$(gh api "repos/${HUB_ORG}/${HUB_REPO}/commits/${{ inputs.hub_release_tag }}" -q .sha)
          if [ "$RESOLVED_SHA" != "$EXPECTED_HUB_SHA" ]; then
            echo "::error::${{ inputs.hub_release_tag }} resolves to $RESOLVED_SHA, expected $EXPECTED_HUB_SHA."
            exit 1
          fi
          echo "Verified ${{ inputs.hub_release_tag }} resolves to $EXPECTED_HUB_SHA."

      - name: Download semantic model package from ontology-hub release
        env:
          GH_TOKEN: ${{ secrets.HUB_REPO_TOKEN }}
        run: |
          gh release download "${{ inputs.hub_release_tag }}" \
            --repo "${HUB_ORG}/${HUB_REPO}" \
            --pattern "powerbi-semantic-model.zip" \
            --output powerbi-semantic-model.zip

      # §8 dataplatform responsibility item 3: verify the archive's SHA-256 before
      # extraction. Fails closed -- a checksum mismatch must never reach fabric-cicd.
      - name: Verify archive SHA-256
        env:
          EXPECTED_ARCHIVE_SHA256: ${{ inputs.expected_archive_sha256 }}
        run: |
          ACTUAL_SHA256=$(sha256sum powerbi-semantic-model.zip | cut -d' ' -f1)
          if [ "$ACTUAL_SHA256" != "$EXPECTED_ARCHIVE_SHA256" ]; then
            echo "::error::powerbi-semantic-model.zip SHA-256 is $ACTUAL_SHA256, expected $EXPECTED_ARCHIVE_SHA256."
            exit 1
          fi
          echo "Verified powerbi-semantic-model.zip SHA-256: $ACTUAL_SHA256"

      - name: Unpack semantic model package
        run: |
          mkdir -p semantic-model
          unzip -q powerbi-semantic-model.zip -d semantic-model

      # DD-206 #12 item 10: TMDL/PBIP normalization happens once, in the hub's Gold
      # emission, before the archive is checksummed. This workflow never normalizes,
      # never rewrites item content (TMDL/PBIP), and never touches the .zip or its
      # verified checksum.
      #
      # Deploy-time parameterisation is a separate concern and IS this side's job:
      # `parameter.yml` exists precisely so one checksummed artifact can be promoted
      # between environments. The hub can only enumerate environments it declares
      # itself, which forced real Fabric GUIDs into a repo that is otherwise
      # infrastructure-agnostic (issue #662). The step below lets this repo supply its
      # own target instead. It rewrites only `replace_value[<target_environment>]` in
      # the already-extracted, already-verified `parameter.yml`, leaves `find_value`
      # exactly as the hub emitted it, and logs before/after so the change is auditable
      # in the run log. No config file, or no matching environment => the hub's values
      # stand. It fails closed when the archive carries no `parameter.yml`, or when
      # `parameter.yml` does not declare target_environment: fabric-cicd would otherwise
      # skip the rewrite and deploy the hub's default workspace (#993).
      #
      # `${FABRIC_WORKSPACE_ID}` / `${FABRIC_ITEM_ID}` in gold-connections.yml resolve
      # from these two, which is the only way a `${VAR}` there can resolve at all: a step
      # sees only the environment it is given (#993).
      - name: Apply dataplatform Direct Lake connection override
        env:
          TARGET_ENVIRONMENT: ${{ inputs.target_environment }}
          FABRIC_WORKSPACE_ID: ${{ vars.FABRIC_WORKSPACE_ID || secrets.FABRIC_WORKSPACE_ID }}
          FABRIC_ITEM_ID: ${{ vars.FABRIC_ITEM_ID || secrets.FABRIC_ITEM_ID }}
        run: |
          uv run --no-sync kairos-ontology apply-gold-connection \
            --package-dir semantic-model \
            --environment "$TARGET_ENVIRONMENT"

      - name: Azure login (service principal)
        uses: azure/login@v2
        with:
          client-id: ${{ secrets.AZURE_CLIENT_ID }}
          tenant-id: ${{ secrets.AZURE_TENANT_ID }}
          subscription-id: ${{ secrets.AZURE_SUBSCRIPTION_ID }}

      - name: Install fabric-cicd
        run: |
          pip install --upgrade pip
          pip install fabric-cicd azure-identity

      # `environment` selects one value per `find_replace` entry of the `parameter.yml`
      # that fabric-cicd reads from the root of `repository_directory`. The hub ships that
      # file at the root of the release package (#993), generated from
      # `gold.direct_lake_connection` or `gold.databricks_connection` in `kairos.yaml`;
      # `target_environment` must be one of the environment keys declared there -- or
      # supplied by the override step above via `.github/fabric/gold-connections.yml` --
      # and the override step refuses to continue when it is not.
      #
      # §8 dataplatform responsibility item 6: both Fabric item types the hub ships
      # (SemanticModel and Report) are deployed together.
      - name: Publish semantic model and report to Fabric workspace
        env:
          FABRIC_WORKSPACE_ID: ${{ secrets.FABRIC_WORKSPACE_ID }}
          TARGET_ENVIRONMENT: ${{ inputs.target_environment }}
        run: |
          python - <<'PY'
          import os
          from pathlib import Path

          from azure.identity import AzureCliCredential
          from fabric_cicd import FabricWorkspace, publish_all_items

          workspace_id = os.environ["FABRIC_WORKSPACE_ID"]
          target_env = os.environ["TARGET_ENVIRONMENT"]
          model_dir = Path("semantic-model").resolve()

          target_workspace = FabricWorkspace(
              workspace_id=workspace_id,
              environment=target_env,
              repository_directory=str(model_dir),
              item_type_in_scope=["SemanticModel", "Report"],
              token_credential=AzureCliCredential(),
          )

          publish_all_items(target_workspace)
          print(f"Published SemanticModel and Report items from: {model_dir}")
          PY

      # DD-238 / #982: advisory Best Practice Analyzer run against the model just
      # published. Some BPA rules need a deployed model with data -- cardinality,
      # referential-integrity violations, Direct Lake guardrails and fallback -- so the hub
      # cannot check them. This publishes fabric/KairosModelBpa.Notebook and runs it.
      #
      # Read-only over the model (DD-206), and never blocking: a finding, or a check that
      # cannot run, must not fail a deploy that succeeded, hence continue-on-error and an
      # exit 0 on every path. Findings are authored back in the hub, never fixed in the
      # deployed model. It skips cleanly without the notebook, or in a workspace with no
      # Fabric, Premium or PPU capacity -- Semantic Link Labs needs XMLA read access,
      # which a Pro workspace (typical for a Databricks DirectQuery model) does not give;
      # CICD.md describes the manual check for that case. Set the FABRIC_BPA_LAKEHOUSE_ID
      # and FABRIC_BPA_LAKEHOUSE_NAME repository variables to persist findings to the
      # kairos_bpa_findings table of that lakehouse; without them they are only printed.
      - name: Advisory Best Practice Analyzer run (non-blocking)
        if: ${{ inputs.run_bpa_advisory }}
        continue-on-error: true
        env:
          FABRIC_WORKSPACE_ID: ${{ secrets.FABRIC_WORKSPACE_ID }}
          TARGET_ENVIRONMENT: ${{ inputs.target_environment }}
          FABRIC_BPA_LAKEHOUSE_ID: ${{ vars.FABRIC_BPA_LAKEHOUSE_ID }}
          FABRIC_BPA_LAKEHOUSE_NAME: ${{ vars.FABRIC_BPA_LAKEHOUSE_NAME }}
        run: |
          python - <<'PY'
          import json
          import os
          import sys
          import time
          import urllib.request
          from pathlib import Path

          from azure.identity import AzureCliCredential
          from fabric_cicd import FabricWorkspace, publish_all_items

          NOTEBOOK = "Kairos Model BPA"
          API = "https://api.fabric.microsoft.com/v1"
          repository = Path("fabric")
          if not (repository / "KairosModelBpa.Notebook").is_dir():
              print("::notice::fabric/KairosModelBpa.Notebook is absent; skipping the advisory"
                    " BPA run. Install it with `kairos-ontology update --refresh-workflows`.")
              sys.exit(0)

          workspace_id = os.environ["FABRIC_WORKSPACE_ID"]
          credential = AzureCliCredential()
          token = credential.get_token("https://api.fabric.microsoft.com/.default").token


          def call(method, path, body=None):
              request = urllib.request.Request(
                  path if path.startswith("https://") else API + path,
                  method=method,
                  data=None if body is None else json.dumps(body).encode("utf-8"),
                  headers={"Authorization": "Bearer " + token, "Content-Type": "application/json"},
              )
              with urllib.request.urlopen(request) as response:
                  payload = response.read()
                  return response.headers, json.loads(payload) if payload else None


          try:
              _, workspace = call("GET", "/workspaces/" + workspace_id)
              if not workspace.get("capacityId"):
                  print("::notice::The workspace has no Fabric, Premium or PPU capacity, so"
                        " Semantic Link Labs cannot read the model; skipping. See CICD.md.")
                  sys.exit(0)

              publish_all_items(
                  FabricWorkspace(
                      workspace_id=workspace_id,
                      environment=os.environ["TARGET_ENVIRONMENT"],
                      repository_directory=str(repository.resolve()),
                      item_type_in_scope=["Notebook"],
                      token_credential=credential,
                  )
              )
              _, items = call("GET", "/workspaces/" + workspace_id + "/items?type=Notebook")
              notebook_id = next(
                  item["id"] for item in items["value"] if item["displayName"] == NOTEBOOK
              )

              platform = next(Path("semantic-model").rglob("*.SemanticModel/.platform"))
              dataset = json.loads(platform.read_text(encoding="utf-8"))["metadata"]["displayName"]
              direct_lake = any(
                  "mode: directLake" in path.read_text(encoding="utf-8")
                  for path in Path("semantic-model").rglob("*.tmdl")
              )
              execution = {
                  "parameters": {
                      "dataset": {"value": dataset, "type": "string"},
                      "workspace": {"value": workspace_id, "type": "string"},
                      "semantic_mode": {
                          "value": "directLake" if direct_lake else "directQuery",
                          "type": "string",
                      },
                  }
              }
              lakehouse_id = os.environ.get("FABRIC_BPA_LAKEHOUSE_ID", "")
              if lakehouse_id:
                  execution["configuration"] = {
                      "defaultLakehouse": {
                          "id": lakehouse_id,
                          "name": os.environ.get("FABRIC_BPA_LAKEHOUSE_NAME", ""),
                          "workspaceId": workspace_id,
                      }
                  }
              headers, _ = call(
                  "POST",
                  "/workspaces/" + workspace_id + "/items/" + notebook_id
                  + "/jobs/instances?jobType=RunNotebook",
                  {"executionData": execution},
              )
              status = "NotStarted"
              for _ in range(60):
                  time.sleep(20)
                  _, job = call("GET", headers["Location"])
                  status = job.get("status", "")
                  if status in ("Completed", "Failed", "Cancelled", "Deduped"):
                      break
              print("Advisory BPA notebook run finished with status:", status)
              if status != "Completed":
                  print("::warning::The advisory BPA run did not complete (" + status + ");"
                        " the deploy itself succeeded. Open the notebook run in Fabric.")
          except Exception as exc:
              print("::warning::The advisory BPA run could not run:", exc)
          sys.exit(0)
          PY
