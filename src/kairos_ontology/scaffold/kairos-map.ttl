# Kairos Mapping Vocabulary v2 — typed scalar contracts (DD-107)

@prefix kairos-map: <https://kairos.cnext.eu/mapping#> .
@prefix macro: <https://kairos.cnext.eu/mapping/macro#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<https://kairos.cnext.eu/mapping>
    a owl:Ontology ;
    rdfs:label "Kairos Mapping Vocabulary" ;
    owl:versionInfo "2.0.0" ;
    rdfs:comment "Structured, typed, deterministic scalar source-to-domain mapping contracts." .

kairos-map:MappingContract a owl:Class ;
    rdfs:label "Mapping Contract" ;
    rdfs:comment "A named, provenance-stable v2 mapping contract." .

kairos-map:TableMapping a owl:Class ;
    rdfs:subClassOf kairos-map:MappingContract ;
    rdfs:label "Table Mapping" ;
    rdfs:comment "A source-table to target-class alignment with an optional typed split predicate." .

kairos-map:ColumnMapping a owl:Class ;
    rdfs:subClassOf kairos-map:MappingContract ;
    rdfs:label "Column Mapping" ;
    rdfs:comment "A source-column to target-property alignment with a typed scalar expression." .

kairos-map:ScalarExpression a owl:Class ;
    rdfs:label "Scalar Expression" ;
    rdfs:comment "An adapter-neutral, deterministic, column-bounded expression node." .

kairos-map:SourceColumnExpression a owl:Class ;
    rdfs:subClassOf kairos-map:ScalarExpression ;
    rdfs:label "Source Column Expression" ;
    rdfs:comment "A source-column IRI resolved against exactly one governed relation." .

kairos-map:LiteralExpression a owl:Class ;
    rdfs:subClassOf kairos-map:ScalarExpression ;
    rdfs:label "Literal Expression" ;
    rdfs:comment "A typed RDF literal rendered with safe SQL literal rules." .

kairos-map:NullExpression a owl:Class ;
    rdfs:subClassOf kairos-map:ScalarExpression ;
    rdfs:label "Null Expression" ;
    rdfs:comment "An explicitly typed NULL." .

kairos-map:OperatorExpression a owl:Class ;
    rdfs:subClassOf kairos-map:ScalarExpression ;
    rdfs:label "Operator Expression" ;
    rdfs:comment "An allowlisted deterministic scalar operator over an ordered RDF argument list." .

kairos-map:FunctionExpression a owl:Class ;
    rdfs:subClassOf kairos-map:ScalarExpression ;
    rdfs:label "Function Expression" ;
    rdfs:comment "An allowlisted deterministic scalar function over an ordered RDF argument list." .

kairos-map:CaseExpression a owl:Class ;
    rdfs:subClassOf kairos-map:ScalarExpression ;
    rdfs:label "Case Expression" ;
    rdfs:comment "A searched CASE with ordered branches and an explicit ELSE expression." .

kairos-map:CaseBranch a owl:Class ;
    rdfs:label "Case Branch" ;
    rdfs:comment "One typed WHEN/THEN branch." .

kairos-map:MacroExpression a owl:Class ;
    rdfs:subClassOf kairos-map:ScalarExpression ;
    rdfs:label "Macro Expression" ;
    rdfs:comment "An invocation of an exact approved namespaced macro IRI." .

kairos-map:ApprovedMacro a owl:Class ;
    rdfs:label "Approved Macro" ;
    rdfs:comment "A toolkit-owned deterministic scalar macro supported by both adapters." .

kairos-map:sourceTable a owl:ObjectProperty ;
    rdfs:domain kairos-map:TableMapping ;
    rdfs:range owl:Thing ;
    rdfs:label "source table" .

kairos-map:targetClass a owl:ObjectProperty ;
    rdfs:domain kairos-map:TableMapping ;
    rdfs:range owl:Class ;
    rdfs:label "target class" .

kairos-map:mappingType a owl:DatatypeProperty ;
    rdfs:domain kairos-map:TableMapping ;
    rdfs:range xsd:string ;
    rdfs:label "mapping type" ;
    rdfs:comment "Either direct or split. Relational/grain-changing forms require a contracted transformation." .

kairos-map:rowFilter a owl:ObjectProperty ;
    rdfs:domain kairos-map:TableMapping ;
    rdfs:range kairos-map:ScalarExpression ;
    rdfs:label "row filter" ;
    rdfs:comment "A typed boolean predicate permitted only for an explicit split mapping." .

kairos-map:sourceColumn a owl:ObjectProperty ;
    rdfs:domain owl:Thing ;
    rdfs:range owl:Thing ;
    rdfs:label "source column" ;
    rdfs:comment "A source-column IRI, never a SQL identifier string." .

kairos-map:targetProperty a owl:ObjectProperty ;
    rdfs:domain kairos-map:ColumnMapping ;
    rdfs:range rdf:Property ;
    rdfs:label "target property" .

kairos-map:matchType a owl:DatatypeProperty ;
    rdfs:domain kairos-map:MappingContract ;
    rdfs:range xsd:string ;
    rdfs:label "SKOS match type" ;
    rdfs:comment "exactMatch, closeMatch, narrowMatch, broadMatch, or relatedMatch." .

kairos-map:reviewState a owl:DatatypeProperty ;
    rdfs:domain kairos-map:MappingContract ;
    rdfs:range xsd:string ;
    rdfs:label "authoring review state" ;
    rdfs:comment "Optional authoring state. Proposed and out-of-scope contracts are not projection authority; absent state preserves legacy approved behavior." .

kairos-map:expression a owl:ObjectProperty ;
    rdfs:domain kairos-map:ColumnMapping ;
    rdfs:range kairos-map:ScalarExpression ;
    rdfs:label "expression" ;
    rdfs:comment "Optional expression root; absence means a derived direct source-column reference." .

kairos-map:outputType a owl:DatatypeProperty ;
    rdfs:domain kairos-map:ScalarExpression ;
    rdfs:range xsd:string ;
    rdfs:label "output type" .

kairos-map:nullable a owl:DatatypeProperty ;
    rdfs:domain kairos-map:ScalarExpression ;
    rdfs:range xsd:boolean ;
    rdfs:label "nullable" .

kairos-map:nullPolicy a owl:DatatypeProperty ;
    rdfs:domain kairos-map:ScalarExpression ;
    rdfs:range xsd:string ;
    rdfs:label "null policy" .

kairos-map:determinism a owl:DatatypeProperty ;
    rdfs:domain kairos-map:ScalarExpression ;
    rdfs:range xsd:string ;
    rdfs:label "determinism" .

kairos-map:requiresCapability a owl:DatatypeProperty ;
    rdfs:domain kairos-map:ScalarExpression ;
    rdfs:range xsd:string ;
    rdfs:label "required adapter capability" .

kairos-map:literalValue a owl:DatatypeProperty ;
    rdfs:domain kairos-map:LiteralExpression ;
    rdfs:range rdfs:Literal ;
    rdfs:label "literal value" .

kairos-map:operator a owl:DatatypeProperty ;
    rdfs:domain kairos-map:OperatorExpression ;
    rdfs:range xsd:string ;
    rdfs:label "operator" .

kairos-map:function a owl:DatatypeProperty ;
    rdfs:domain kairos-map:FunctionExpression ;
    rdfs:range xsd:string ;
    rdfs:label "function" .

kairos-map:arguments a owl:ObjectProperty ;
    rdfs:domain kairos-map:ScalarExpression ;
    rdfs:range rdf:List ;
    rdfs:label "ordered arguments" .

kairos-map:branches a owl:ObjectProperty ;
    rdfs:domain kairos-map:CaseExpression ;
    rdfs:range rdf:List ;
    rdfs:label "ordered CASE branches" .

kairos-map:when a owl:ObjectProperty ;
    rdfs:domain kairos-map:CaseBranch ;
    rdfs:range kairos-map:ScalarExpression ;
    rdfs:label "when expression" .

kairos-map:then a owl:ObjectProperty ;
    rdfs:domain kairos-map:CaseBranch ;
    rdfs:range kairos-map:ScalarExpression ;
    rdfs:label "then expression" .

kairos-map:elseExpression a owl:ObjectProperty ;
    rdfs:domain kairos-map:CaseExpression ;
    rdfs:range kairos-map:ScalarExpression ;
    rdfs:label "else expression" .

kairos-map:macro a owl:ObjectProperty ;
    rdfs:domain kairos-map:MacroExpression ;
    rdfs:range kairos-map:ApprovedMacro ;
    rdfs:label "approved macro" .

macro:concat a kairos-map:ApprovedMacro ;
    rdfs:label "portable concat" .

macro:dayOfWeek a kairos-map:ApprovedMacro ;
    rdfs:label "portable day of week" .

macro:monthName a kairos-map:ApprovedMacro ;
    rdfs:label "portable month name" .

macro:quarter a kairos-map:ApprovedMacro ;
    rdfs:label "portable quarter" .
