[project]
name = "{repo_name}"
version = "0.1.0"
description = "Kairos ontology hub — {description}"
requires-python = ">=3.12"
dependencies = [
    "kairos-ontology-toolkit @ https://github.com/Cnext-eu/kairos-ontology-toolkit/releases/download/{toolkit_ref}/kairos_ontology_toolkit-{toolkit_version}-py3-none-any.whl",
    "kairos-ontology-referencemodels @ https://github.com/Cnext-eu/kairos-ontology-referencemodels/releases/download/{refmodels_ref}/kairos_ontology_referencemodels-{refmodels_version}-py3-none-any.whl",
]

[project.optional-dependencies]
dev = [
    "pytest>=8.0",
]
dbt-validate = [
    "dbt-core>=1.9,<1.10",
    "dbt-fabric>=1.9,<1.10",
]
dbt-validate-fabric = [
    "dbt-core>=1.9,<1.10",
    "dbt-fabric>=1.9,<1.10",
]
dbt-validate-databricks = [
    "dbt-core>=1.9,<1.10",
    "dbt-databricks>=1.9,<1.10",
]
# Toolkit extras. These deliberately carry NO URL: the single direct reference in
# [project.dependencies] above is the one and only place the toolkit version is pinned,
# and extras of the same distribution resolve through it. Repeating the wheel URL here
# (as hubs scaffolded before toolkit 5.2 did) created five copies of one version that
# nothing kept in agreement — see issue #297.
flatfile = [
    "kairos-ontology-toolkit[flatfile]",
]
azure = [
    "kairos-ontology-toolkit[azure]",
]
foundry = [
    "kairos-ontology-toolkit[foundry]",
]
parquet = [
    "kairos-ontology-toolkit[parquet]",
]
otel = [
    "kairos-ontology-toolkit[otel]",
]
langfuse = [
    "kairos-ontology-toolkit[langfuse]",
]

[tool.kairos]
# Channel controls which toolkit version is installed on `kairos-ontology update --upgrade`.
#   "stable"  — latest GA release (default)
#   "preview" — latest pre-release (rc/beta/alpha) for testing new features
#   "v2.16.0" — explicit pinned version
# To test unreleased toolkit code without changing this channel:
#   uv run kairos-ontology update --test-ref <branch-or-sha>
# The command pins an immutable SHA and saves exact restore metadata below temporarily.
# Return to the prior dependency source with: uv run kairos-ontology update --restore
# This channel is written by the scaffolder to match the pin above, so `update --upgrade`
# moves forward from it instead of resolving to an older release.
channel = "{toolkit_channel}"

# Optional accelerator pack selected for scoped validation and projection. When omitted,
# Kairos infers a single installed pack and requires an explicit choice if several exist.
# accelerator = "logistics"

# Default concurrency for the LLM-powered pre-modeling steps (analyse-sources,
# propose-alignment). --max-workers on the command line always overrides this.
# Omitted here, both commands default to 16 (network-bound calls; the useful
# ceiling is the provider's rate limit, not the core count).
# max_workers = 16
