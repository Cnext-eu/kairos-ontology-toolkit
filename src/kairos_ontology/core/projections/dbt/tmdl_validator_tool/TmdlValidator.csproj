<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SPDX-License-Identifier: Apache-2.0
    Copyright 2026 Cnext.eu

    Issue #619 feature request: validate generated TMDL with the same engine Power BI
    Desktop and Fabric use to open it (Microsoft.AnalysisServices.Tabular's
    TmdlSerializer), so a syntax/structure error is caught at projection time with an
    exact file/line, instead of only surfacing as a cryptic dialog when a human opens
    the PBIP in Desktop. Bundled as source (not a prebuilt binary) under the Python
    package so it ships with the wheel like every other scaffold asset; built once and
    run with `dotnet <dll>` by tmdl_validate.py. Optional for Gold validation, required
    for `import-tmdl`, which reads Power BI models with its inventory mode (#879, DD-237).
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AnalysisServices" Version="19.84.6" />
  </ItemGroup>

</Project>
