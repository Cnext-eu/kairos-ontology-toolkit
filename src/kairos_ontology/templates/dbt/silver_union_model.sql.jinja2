-- Silver union model: {{ model_name }}
-- Domain: {{ domain_name }} ({{ schema_name }})
-- Generated by Kairos Ontology Toolkit (dbt projector)
-- Non-runtime union: no SCD or incremental behavior is inferred.
{{"{{"}} config(
    materialized='{{ materialization | default("table") }}',
    schema='{{ schema_name }}'
) {{"}}"}}

with unioned as (
{%- for source_model in source_models %}
    select
{%- for column in columns %}
{%- if not column.generated_after_mapping | default(false) and not column.runtime_generated | default(false) %}
        {{ column.target_name }},
{%- endif %}
{%- endfor %}
        1 as _kairos_union_guard
    from {{"{{"}} ref('{{ source_model }}') {{"}}"}}
{%- if not loop.last %}
    union all
{%- endif %}
{%- endfor %}
)
{%- if branch_relationship == "exactly-equivalent" %}
,
conformance_ranked as (
    select
        *,
        row_number() over (
            partition by {{ integration_key_expression }}
            order by
                case _source_identity_ref
{%- for source in source_precedence %}
                    when '{{ source }}' then {{ loop.index }}
{%- endfor %}
                    else {{ source_precedence | length + 1 }}
                end,
                _source_record_key
        ) as _kairos_conformance_rank
    from unioned
),
conformed as (
    select *
    from conformance_ranked
    where _kairos_conformance_rank = 1
)
{%- endif %}
select
{%- for column in columns %}
    {% if column.generated_after_mapping | default(false) %}{{ column.expression }} as {{ column.target_name }}{% else %}{{ column.target_name }}{% endif %}{% if not loop.last %},{% endif %}
{%- endfor %}
from {% if branch_relationship == "exactly-equivalent" %}conformed{% else %}unioned{% endif %}
