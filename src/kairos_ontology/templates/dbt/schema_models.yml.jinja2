version: 2

models:
{%- for model in models %}
  - name: {{ model.name }}
    description: {{ model.description | tojson }}
{%- if model.contract_enforced %}
    config:
      contract:
        enforced: true
{%- endif %}
{%- if model.meta %}
    meta:
{%- for key, value in model.meta.items() %}
      {{ key }}: "{{ value }}"
{%- endfor %}
{%- endif %}
{#- Generic-test arguments are nested under `arguments:` (dbt 1.10+). The old
    top-level form raises MissingArgumentsPropertyInGenericTestDeprecation on dbt
    1.12 and is slated to become a hard error, at which point the emitted package
    stops parsing (#826). `config` is a dbt-level concern rather than a test
    argument, so it deliberately stays at the top level. -#}
{%- if model.data_tests or (model.grain_columns and model.grain_columns | length > 1) %}
    data_tests:
{%- for test in model.data_tests %}
      - {{ test | tojson }}
{%- endfor %}
{%- if model.grain_columns and model.grain_columns | length > 1 %}
      - dbt_utils.unique_combination_of_columns:
          arguments:
            combination_of_columns:
{%- for grain_column in model.grain_columns %}
              - {{ grain_column }}
{%- endfor %}
{%- if model.grain_where %}
          config:
            where: {{ model.grain_where }}
{%- endif %}
{%- if model.source_identity_columns != model.grain_columns %}
      - dbt_utils.unique_combination_of_columns:
          arguments:
            combination_of_columns:
{%- for identity_column in model.source_identity_columns %}
              - {{ identity_column }}
{%- endfor %}
{%- if model.grain_where %}
          config:
            where: {{ model.grain_where }}
{%- endif %}
{%- endif %}
{%- endif %}
{%- endif %}
    columns:
{%- for column in model.columns %}
      - name: {{ column.name }}
        description: {{ column.description | tojson }}
{%- if column.data_type %}
        data_type: {{ column.data_type }}
{%- endif %}
{%- if column.meta %}
        meta:
{%- for key, value in column.meta.items() %}
          {{ key }}: "{{ value }}"
{%- endfor %}
{%- endif %}
{%- if column.tests %}
{#- Same shape as the model-level block above (#826): arguments under `arguments:`,
    `config` at the test's own level. Values are emitted as JSON, which YAML reads,
    rather than as Python reprs. The `tests:` key itself is not deprecated. #}
        tests:
{%- for test in column.tests %}
{%- if test is mapping %}
{%- set test_name = test.keys() | first %}
{%- set body = test[test_name] %}
          - {{ test_name }}:
{%- if body | reject('equalto', 'config') | list %}
              arguments:
{%- for key, value in body.items() if key != 'config' %}
                {{ key }}: {{ value | tojson }}
{%- endfor %}
{%- endif %}
{%- if 'config' in body %}
              config: {{ body['config'] | tojson }}
{%- endif %}
{%- else %}
          - {{ test }}
{%- endif %}
{%- endfor %}
{%- endif %}
{%- endfor %}
{%- endfor %}
