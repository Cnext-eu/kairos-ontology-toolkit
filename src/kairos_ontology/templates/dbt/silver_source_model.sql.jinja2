{%- if ref_model %}
    from {{"{{"}} ref('{{ ref_model }}') {{"}}"}} as {{ source_alias }}
{%- else %}
    from {{"{{"}} source('{{ source_name }}', '{{ raw_table_name }}') {{"}}"}} as {{ source_alias }}
{%- endif %}
{%- for join in joins %}
    {{ join.type }} join {{ join.ref }} as {{ join.alias }}
        on {{ join.condition }}
{%- endfor %}
