# Kairos Ontology Toolkit — AI Provider Configuration
# Copy this file as .env and fill in the values for your environment.
# Do NOT commit .env to source control.

# ---------------------------------------------------------------------------
# AI Provider Selection
# ---------------------------------------------------------------------------
# Supported values: github, azure, foundry
# Default: github (if GITHUB_TOKEN is set)
# KAIROS_AI_PROVIDER=github

# ---------------------------------------------------------------------------
# GitHub Models (default)
# ---------------------------------------------------------------------------
# Uses GitHub's inference API at https://models.inference.ai.azure.com
# Requires a GitHub PAT with Models API access.
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Azure AI Foundry (legacy OpenAI-compatible endpoint)
# ---------------------------------------------------------------------------
# Uses your Azure AI Foundry deployment endpoint with the OpenAI SDK directly.
# Set both AZURE_AI_ENDPOINT and AZURE_AI_KEY, or configure Azure identity.
# AZURE_AI_ENDPOINT=https://your-project.services.ai.azure.com/models
# AZURE_AI_KEY=your-api-key-here

# For Azure identity (no key needed):
# Install: uv sync --extra azure
# Then set AZURE_AI_ENDPOINT and leave AZURE_AI_KEY unset.
# DefaultAzureCredential supports `az login`, workload identity, and managed identity.

# ---------------------------------------------------------------------------
# Microsoft Foundry (recommended for enterprise)
# ---------------------------------------------------------------------------
# Uses the azure-ai-projects SDK with the Foundry project endpoint.
# Install: uv sync --extra foundry
#
# Format: https://<resource>.services.ai.azure.com/api/projects/<project>
#
# KAIROS_AI_PROVIDER=foundry
# AZURE_FOUNDRY_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project
#
# Two auth modes, both supported:
#
# 1. Entra ID (no key): set AZURE_FOUNDRY_ENDPOINT to the project endpoint above and
#    sign in with `az login` (or use a managed identity). This goes through the
#    azure-ai-projects SDK, which authenticates with an AAD token. Requires the
#    "Foundry User" (or higher) RBAC role on the resource.
#
# 2. API key: set AZURE_FOUNDRY_API_KEY as well. The key authenticates the resource's
#    OpenAI-compatible surface (<resource>/openai/v1) directly, bypassing the projects
#    SDK — that SDK needs a token credential and cannot use a key. The endpoint is
#    normalized for you, so either the project endpoint or the bare resource URL works.
# AZURE_FOUNDRY_API_KEY=your-api-key-here
#
# Note on model names: these must be your *deployment* names, not model family names.
# A wrong deployment name surfaces as HTTP 404 from the inference call — check-ai-config
# reports that separately from an unreachable endpoint.

# ---------------------------------------------------------------------------
# Model override (optional — default: gpt-5.4-mini)
# ---------------------------------------------------------------------------
# KAIROS_AI_MODEL=gpt-5.4-mini

# ---------------------------------------------------------------------------
# Per-role endpoints (optional — issue #182; roles collapsed to one, issue #562)
# ---------------------------------------------------------------------------
# analyse-sources and propose-alignment both run under the "alignment" role —
# one configured provider, the strongest one, for every pre-modeling LLM call.
# (There used to be a separate, cheaper "affinity" role for analyse-sources;
# issue #562 removed it.)
#
# If the role's *_ENDPOINT is set, that OpenAI-compatible endpoint + key is used
# for both steps. If only *_MODEL is set, the role keeps the global provider
# above but overrides just the model. Anything unset falls back to the global
# config.
#
# *_MODEL is a *default*: an explicit `--model` (or `--high-accuracy`) on the
# command line always wins over it.
#
# KAIROS_AI_ALIGNMENT_MODEL=gpt-5.4
# KAIROS_AI_ALIGNMENT_ENDPOINT=https://your-strong-deployment.services.ai.azure.com/models
# KAIROS_AI_ALIGNMENT_KEY=your-alignment-key

# ---------------------------------------------------------------------------
# Raw sample values for the alignment LLM prompt (DD-205, issue #562)
# ---------------------------------------------------------------------------
# NOTE (DD-214, issue #692): import-source/import-flatfile/extract-schema no
# longer redact by default -- redaction is opt-in via --redact-pii. The
# committed vocabulary/source-dir files may therefore contain raw sample
# values, which is the condition DD-205 originally relied on NOT being true.
# This setting governs a SEPARATE, gitignored channel
# (.import/raw-samples/) captured at the same import step, which the
# alignment LLM prompt and the example_values review field read from when
# available. SENT BY DEFAULT: real sample values reach your configured AI
# provider. Set this to 0 before importing to never write the channel at all
# (off means off, not just "won't be read"); example_values then also
# reverts to its original PII-masked behavior.
# KAIROS_ALIGNMENT_SEND_RAW_SAMPLES=1

# ---------------------------------------------------------------------------
# Offline dbt validation (ontology hub)
# ---------------------------------------------------------------------------
# The kairos-execute-project skill uses these version families when validating
# generated dbt output in ontology-hub-publish/medallion/dbt without a live
# warehouse connection. The legacy dbt-validate extra remains the Fabric alias.
# Install one adapter environment at a time:
#   uv sync --extra dbt-validate-fabric
#   uv sync --extra dbt-validate-databricks
#
# KAIROS_DBT_CORE_VERSION=>=1.9,<1.10
# KAIROS_DBT_VALIDATE_ADAPTER=dbt-fabric
# KAIROS_DBT_VALIDATE_ADAPTER_VERSION=>=1.9,<1.10

# ---------------------------------------------------------------------------
# Langfuse LLM tracing (DD-184) — optional, off by default
# ---------------------------------------------------------------------------
# Records every pipeline model call — prompt, response, model, seed, reasoning
# effort, token cost — so a questionable mapping can be inspected after the fact
# instead of reproduced under a debug script.
#
# Install:  uv sync --group langfuse       (or: pip install 'kairos-ontology-toolkit[langfuse]')
#
# All three must be set before tracing activates. There is no default host, so a
# hub cannot ship traces anywhere by accident. Keys come from your Langfuse
# project under Settings -> API Keys.
#
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com          # EU cloud
#   ...or https://us.cloud.langfuse.com             # US cloud
#   ...or https://langfuse.internal.example.com     # self-hosted
#
# Separates traces from different environments in the Langfuse UI.
# KAIROS_LANGFUSE_ENVIRONMENT=development
#
# PRIVACY — read before enabling against a hosted Langfuse.
# Alignment prompts contain real sample values from your source tables. They are
# SENT BY DEFAULT once tracing itself is configured above — that sample signal
# is what a reviewer needs to diagnose a bad mapping. Set this to 0 to mask the
# "| samples: ..." block instead and send only column names, types, the
# reference classes offered, the instructions and the model's response
# (appropriate when Langfuse is a third party's cloud rather than self-hosted).
# KAIROS_LANGFUSE_SEND_SAMPLES=1
